@inject IDbContextFactory<DataChat.Infrastructure.Persistence.ApplicationDbContext> DbContextFactory

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link href="_content/Microsoft.FluentUI.AspNetCore.Components/css/reboot.css" rel="stylesheet" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="DataChat.Web.styles.css" />
    <link rel="icon" type="image/png" href="@_faviconPath" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    @* Use InteractiveServer with prerender=true so initial auth check happens during static render *@
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: true)" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Microsoft.FluentUI.AspNetCore.Components/Microsoft.FluentUI.AspNetCore.Components.lib.module.js" type="module" async></script>
</body>

</html>

@code {
    private string _faviconPath = "favicon.png";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var branding = await dbContext.BrandingConfiguration.FirstOrDefaultAsync();
            if (branding != null && !string.IsNullOrEmpty(branding.FaviconPath))
            {
                _faviconPath = branding.FaviconPath;
            }
        }
        catch
        {
            // Use default favicon
        }
    }
}
