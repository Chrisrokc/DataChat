    // Export functionality
    private async Task ExportChat(string format)
    {
        if (_selectedChat == null || !_messages.Any())
        {
            ToastService.ShowWarning("No messages to export");
            return;
        }

        string content;
        string filename;
        string mimeType;

        switch (format.ToLowerInvariant())
        {
            case "markdown":
                content = GenerateMarkdownExport();
                filename = $"{SanitizeFilename(_selectedChat.Title)}.md";
                mimeType = "text/markdown";
                break;
            case "json":
                content = GenerateJsonExport();
                filename = $"{SanitizeFilename(_selectedChat.Title)}.json";
                mimeType = "application/json";
                break;
            case "text":
            default:
                content = GenerateTextExport();
                filename = $"{SanitizeFilename(_selectedChat.Title)}.txt";
                mimeType = "text/plain";
                break;
        }

        await JSRuntime.InvokeVoidAsync("downloadFile", filename, content, mimeType);
        ToastService.ShowSuccess($"Chat exported as {format}");
    }

    private string GenerateMarkdownExport()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"# {_selectedChat!.Title}");
        sb.AppendLine($"*Exported on {DateTime.Now:MMMM d, yyyy 'at' h:mm tt}*");
        sb.AppendLine();
        sb.AppendLine("---");
        sb.AppendLine();

        foreach (var msg in _messages)
        {
            var role = msg.Role == MessageRole.User ? "**You**" : $"**{_aiAssistantName}**";
            var timestamp = FormatTimestamp(msg.CreatedAt);
            sb.AppendLine($"### {role} ({timestamp})");
            sb.AppendLine();
            sb.AppendLine(msg.Content);
            sb.AppendLine();
        }

        return sb.ToString();
    }

    private string GenerateJsonExport()
    {
        var export = new
        {
            title = _selectedChat!.Title,
            exportedAt = DateTime.UtcNow,
            messages = _messages.Select(m => new
            {
                role = m.Role.ToString(),
                content = m.Content,
                timestamp = m.CreatedAt,
                hasAttachments = m.Attachments?.Any() ?? false
            })
        };
        return JsonSerializer.Serialize(export, new JsonSerializerOptions { WriteIndented = true });
    }

    private string GenerateTextExport()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine(_selectedChat!.Title);
        sb.AppendLine(new string('=', _selectedChat.Title.Length));
        sb.AppendLine($"Exported on {DateTime.Now:MMMM d, yyyy 'at' h:mm tt}");
        sb.AppendLine();

        foreach (var msg in _messages)
        {
            var role = msg.Role == MessageRole.User ? "You" : _aiAssistantName;
            var timestamp = FormatTimestamp(msg.CreatedAt);
            sb.AppendLine($"[{role}] ({timestamp})");
            sb.AppendLine(msg.Content);
            sb.AppendLine();
        }

        return sb.ToString();
    }

    private static string SanitizeFilename(string filename)
    {
        var invalid = Path.GetInvalidFileNameChars();
        var sanitized = string.Join("_", filename.Split(invalid, StringSplitOptions.RemoveEmptyEntries));
        return sanitized.Length > 50 ? sanitized[..50] : sanitized;
    }

