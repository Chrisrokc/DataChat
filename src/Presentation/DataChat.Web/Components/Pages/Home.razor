    [JSInvokable]
    public async Task HandleNewChatShortcut()
    {
        await CreateNewChat();
        StateHasChanged();
    }

    [JSInvokable]
    public async Task HandleSearchShortcut()
    {
        await JSRuntime.InvokeVoidAsync("focusElement", ".search-input");
    }

    [JSInvokable]
    public void HandleEscapeShortcut()
    {
        // Cancel edit mode
        if (_editingMessageId != null)
        {
            CancelEdit();
        }
        // Cancel rename mode
        if (_renamingChatId != null)
        {
            CancelRename();
        }
        // Close export menu
        if (_showExportMenu)
        {
            _showExportMenu = false;
            StateHasChanged();
        }
        // Stop generation
        if (_isStreaming)
        {
            StopGeneration();
        }
    }

    // Stop generation
    private void StopGeneration()
    {
        _streamingCts?.Cancel();
    }

    // Pin/favorite functionality
    private async Task LoadPinnedChats()
    {
        // Load pinned chat IDs from local storage via JS
        try
        {
            var pinnedJson = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "datachat_pinned_chats");
            if (!string.IsNullOrEmpty(pinnedJson))
            {
                var pinnedIds = JsonSerializer.Deserialize<List<Guid>>(pinnedJson);
                _pinnedChatIds = new HashSet<Guid>(pinnedIds ?? new List<Guid>());
            }
        }
        catch { /* Ignore localStorage errors */ }
        StateHasChanged();
    }

    private async Task TogglePinChat(ChatDto chat)
    {
        try
        {
            var chatEntity = await DbContext.Chats.FindAsync(chat.Id);
            if (chatEntity != null)
            {
                chatEntity.IsPinned = !chatEntity.IsPinned;
                await DbContext.SaveChangesAsync();

                // Update local state
                var chatIndex = _chats.FindIndex(c => c.Id == chat.Id);
                if (chatIndex >= 0)
                {
                    _chats[chatIndex] = chat with { IsPinned = chatEntity.IsPinned };
                }
                if (_selectedChat?.Id == chat.Id)
                {
                    _selectedChat = _selectedChat with { IsPinned = chatEntity.IsPinned };
                }

                FilterChats();
                ToastService.ShowInfo(chatEntity.IsPinned ? "Chat pinned" : "Chat unpinned");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to pin: {ex.Message}");
        }
    }

    // Rename functionality
    private void StartRenameChat(ChatDto chat)
    {
        _renamingChatId = chat.Id;
        _renameChatTitle = chat.Title;
        StateHasChanged();
    }

    private void CancelRename()
    {
        _renamingChatId = null;
        _renameChatTitle = "";
        StateHasChanged();
    }

    private async Task SaveRenamedChat(ChatDto chat)
    {
        if (string.IsNullOrWhiteSpace(_renameChatTitle))
        {
            CancelRename();
            return;
        }

        try
        {
            var chatEntity = await DbContext.Chats.FindAsync(chat.Id);
            if (chatEntity != null)
            {
                chatEntity.Title = _renameChatTitle.Trim();
                chatEntity.UpdatedAt = DateTimeService.UtcNow;
                await DbContext.SaveChangesAsync();

                // Update local state
                var chatIndex = _chats.FindIndex(c => c.Id == chat.Id);
                if (chatIndex >= 0)
                {
                    _chats[chatIndex] = chat with { Title = _renameChatTitle.Trim() };
                }

                if (_selectedChat?.Id == chat.Id)
                {
                    _selectedChat = _selectedChat with { Title = _renameChatTitle.Trim() };
                }

                FilterChats();
                ToastService.ShowSuccess("Chat renamed");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to rename: {ex.Message}");
        }

        _renamingChatId = null;
        _renameChatTitle = "";
        StateHasChanged();
    }

    private async Task HandleRenameKeyDown(KeyboardEventArgs args, ChatDto chat)
    {
        if (args.Key == "Enter")
        {
            await SaveRenamedChat(chat);
        }
        else if (args.Key == "Escape")
        {
            CancelRename();
        }
    }

