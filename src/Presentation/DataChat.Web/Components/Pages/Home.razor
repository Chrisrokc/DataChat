    // Markdown rendering with syntax highlighting
    private string RenderMarkdown(string content)
    {
        if (string.IsNullOrEmpty(content)) return "";

        var sb = new System.Text.StringBuilder();
        var lines = content.Split('\n');
        var inCodeBlock = false;
        var codeBlockContent = new System.Text.StringBuilder();
        var codeLanguage = "";
        var codeBlockId = 0;

        foreach (var rawLine in lines)
        {
            var line = rawLine;

            // Handle code blocks
            if (line.TrimStart().StartsWith("```"))
            {
                if (!inCodeBlock)
                {
                    inCodeBlock = true;
                    codeLanguage = line.TrimStart().Substring(3).Trim();
                    codeBlockContent.Clear();
                }
                else
                {
                    inCodeBlock = false;
                    var code = System.Net.WebUtility.HtmlEncode(codeBlockContent.ToString().TrimEnd());
                    var highlightedCode = ApplySyntaxHighlighting(code, codeLanguage);
                    codeBlockId++;
                    sb.AppendLine($"<div class=\"code-block-container\">");
                    sb.AppendLine($"<div class=\"code-block-header\"><span class=\"code-block-lang\">{(string.IsNullOrEmpty(codeLanguage) ? "code" : codeLanguage)}</span>");
                    sb.AppendLine($"<button class=\"code-copy-btn\" onclick=\"copyCodeBlock(decodeURIComponent('{Uri.EscapeDataString(codeBlockContent.ToString().TrimEnd())}'))\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 20 20\" fill=\"currentColor\"><path d=\"M8 2a2 2 0 00-2 2v10a2 2 0 002 2h6a2 2 0 002-2V4a2 2 0 00-2-2H8zM6 4a2 2 0 012-2h.5v1H8a1 1 0 00-1 1v10a1 1 0 001 1h6a1 1 0 001-1V4a1 1 0 00-1-1h-.5V2H14a2 2 0 012 2v10a2 2 0 01-2 2H8a2 2 0 01-2-2V4z\"/><path d=\"M4 6a2 2 0 012-2h.5v1H6a1 1 0 00-1 1v10a1 1 0 001 1h6a1 1 0 001-1v-.5h1v.5a2 2 0 01-2 2H6a2 2 0 01-2-2V6z\"/></svg>Copy</button></div>");
                    sb.AppendLine($"<pre><code class=\"code-block\">{highlightedCode}</code></pre></div>");
                    codeLanguage = "";
                }
                continue;
            }

            if (inCodeBlock)
            {
                codeBlockContent.AppendLine(line);
                continue;
            }

            // Process inline markdown
            line = ProcessInlineMarkdown(line);

            // Headers
            if (line.StartsWith("### "))
                line = $"<h3>{line.Substring(4)}</h3>";
            else if (line.StartsWith("## "))
                line = $"<h2>{line.Substring(3)}</h2>";
            else if (line.StartsWith("# "))
                line = $"<h1>{line.Substring(2)}</h1>";
            // Blockquote
            else if (line.StartsWith("> "))
                line = $"<blockquote>{line.Substring(2)}</blockquote>";
            // Horizontal rule
            else if (line.Trim() == "---" || line.Trim() == "***")
                line = "<hr/>";
            // Unordered list
            else if (Regex.IsMatch(line, @"^[\*\-\+]\s"))
                line = $"<li>{line.Substring(2)}</li>";
            // Ordered list
            else if (Regex.IsMatch(line, @"^\d+\.\s"))
                line = $"<li>{Regex.Replace(line, @"^\d+\.\s", "")}</li>";
            // Regular paragraph
            else if (!string.IsNullOrWhiteSpace(line))
                line = $"<p>{line}</p>";

            sb.AppendLine(line);
        }

        // Handle unclosed code block
        if (inCodeBlock)
        {
            var code = System.Net.WebUtility.HtmlEncode(codeBlockContent.ToString().TrimEnd());
            var highlightedCode = ApplySyntaxHighlighting(code, codeLanguage);
            sb.AppendLine($"<div class=\"code-block-container\">");
            sb.AppendLine($"<div class=\"code-block-header\"><span class=\"code-block-lang\">{(string.IsNullOrEmpty(codeLanguage) ? "code" : codeLanguage)}</span></div>");
            sb.AppendLine($"<pre><code class=\"code-block\">{highlightedCode}</code></pre></div>");
        }

        // Wrap consecutive list items in ul/ol
        var result = sb.ToString();
        result = Regex.Replace(result, @"(<li>.*?</li>\n?)+", m => $"<ul>{m.Value}</ul>");

        return result;
    }

    private string ProcessInlineMarkdown(string line)
    {
        // Bold: **text** or __text__
        line = Regex.Replace(line, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        line = Regex.Replace(line, @"__(.+?)__", "<strong>$1</strong>");

        // Italic: *text* or _text_
        line = Regex.Replace(line, @"\*([^*]+)\*", "<em>$1</em>");
        line = Regex.Replace(line, @"_([^_]+)_", "<em>$1</em>");

        // Inline code: `code`
        line = Regex.Replace(line, @"`([^`]+)`", m => $"<code>{System.Net.WebUtility.HtmlEncode(m.Groups[1].Value)}</code>");

        // Links: [text](url)
        line = Regex.Replace(line, @"\[([^\]]+)\]\(([^)]+)\)", "<a href=\"$2\" target=\"_blank\" rel=\"noopener\">$1</a>");

        return line;
    }

    private string ApplySyntaxHighlighting(string code, string language)
    {
        // Basic syntax highlighting for common languages
        var lang = language.ToLowerInvariant();

        // Keywords by language
        var keywords = lang switch
        {
            "csharp" or "c#" or "cs" => new[] { "using", "namespace", "class", "public", "private", "protected", "internal", "static", "void", "string", "int", "bool", "var", "new", "return", "if", "else", "for", "foreach", "while", "try", "catch", "finally", "throw", "async", "await", "override", "virtual", "abstract", "interface", "struct", "enum", "const", "readonly", "null", "true", "false", "this", "base", "get", "set", "value", "where", "select", "from", "in", "out", "ref", "params", "yield", "break", "continue", "switch", "case", "default", "typeof", "sizeof", "is", "as", "lock", "checked", "unchecked", "fixed", "delegate", "event", "operator", "implicit", "explicit", "extern", "unsafe", "volatile", "stackalloc", "nameof", "record", "init", "required", "partial" },
            "javascript" or "js" or "typescript" or "ts" => new[] { "const", "let", "var", "function", "return", "if", "else", "for", "while", "do", "switch", "case", "break", "continue", "default", "try", "catch", "finally", "throw", "new", "this", "class", "extends", "super", "import", "export", "from", "as", "async", "await", "yield", "null", "undefined", "true", "false", "typeof", "instanceof", "in", "of", "delete", "void", "static", "get", "set", "constructor", "interface", "type", "enum", "implements", "private", "public", "protected", "readonly", "abstract" },
            "python" or "py" => new[] { "def", "class", "return", "if", "elif", "else", "for", "while", "try", "except", "finally", "raise", "import", "from", "as", "with", "pass", "break", "continue", "and", "or", "not", "in", "is", "None", "True", "False", "lambda", "yield", "global", "nonlocal", "assert", "del", "async", "await", "self", "cls" },
            "java" => new[] { "public", "private", "protected", "static", "final", "abstract", "class", "interface", "extends", "implements", "new", "return", "if", "else", "for", "while", "do", "switch", "case", "break", "continue", "default", "try", "catch", "finally", "throw", "throws", "import", "package", "void", "int", "long", "double", "float", "boolean", "char", "byte", "short", "null", "true", "false", "this", "super", "instanceof", "enum", "assert", "synchronized", "volatile", "transient", "native", "strictfp" },
            "sql" => new[] { "SELECT", "FROM", "WHERE", "JOIN", "LEFT", "RIGHT", "INNER", "OUTER", "ON", "AND", "OR", "NOT", "IN", "LIKE", "BETWEEN", "IS", "NULL", "ORDER", "BY", "GROUP", "HAVING", "LIMIT", "OFFSET", "INSERT", "INTO", "VALUES", "UPDATE", "SET", "DELETE", "CREATE", "TABLE", "INDEX", "VIEW", "DROP", "ALTER", "ADD", "COLUMN", "PRIMARY", "KEY", "FOREIGN", "REFERENCES", "UNIQUE", "DEFAULT", "CHECK", "CONSTRAINT", "AS", "DISTINCT", "COUNT", "SUM", "AVG", "MIN", "MAX", "CASE", "WHEN", "THEN", "ELSE", "END", "UNION", "ALL", "EXISTS", "EXEC", "DECLARE", "BEGIN", "COMMIT", "ROLLBACK", "TRANSACTION" },
            "html" or "xml" => Array.Empty<string>(),
            "css" or "scss" or "sass" => new[] { "important", "none", "auto", "inherit", "initial", "unset" },
            "bash" or "sh" or "shell" => new[] { "if", "then", "else", "elif", "fi", "for", "while", "do", "done", "case", "esac", "function", "return", "exit", "echo", "read", "export", "local", "readonly", "shift", "break", "continue", "true", "false", "in" },
            "go" => new[] { "package", "import", "func", "return", "if", "else", "for", "range", "switch", "case", "default", "break", "continue", "fallthrough", "goto", "defer", "go", "select", "chan", "map", "struct", "interface", "type", "const", "var", "true", "false", "nil", "iota", "make", "new", "append", "len", "cap", "close", "copy", "delete", "panic", "recover" },
            "rust" => new[] { "fn", "let", "mut", "const", "static", "if", "else", "match", "loop", "while", "for", "in", "break", "continue", "return", "struct", "enum", "impl", "trait", "type", "where", "pub", "mod", "use", "crate", "self", "super", "as", "async", "await", "dyn", "move", "ref", "unsafe", "extern", "true", "false", "Some", "None", "Ok", "Err", "Self" },
            _ => Array.Empty<string>()
        };

        if (keywords.Length > 0)
        {
            // Highlight strings first (to avoid keyword highlighting inside strings)
            code = Regex.Replace(code, @"(&quot;[^&]*?&quot;|&#39;[^&]*?&#39;|&apos;[^&]*?&apos;)", "<span class=\"hljs-string\">$1</span>");
            code = Regex.Replace(code, @"(""[^""]*?"")", "<span class=\"hljs-string\">$1</span>");

            // Highlight comments
            code = Regex.Replace(code, @"(//.*?)$", "<span class=\"hljs-comment\">$1</span>", RegexOptions.Multiline);
            code = Regex.Replace(code, @"(#.*?)$", "<span class=\"hljs-comment\">$1</span>", RegexOptions.Multiline);
            code = Regex.Replace(code, @"(/\*[\s\S]*?\*/)", "<span class=\"hljs-comment\">$1</span>");

            // Highlight numbers
            code = Regex.Replace(code, @"\b(\d+\.?\d*)\b", "<span class=\"hljs-number\">$1</span>");

            // Highlight keywords
            foreach (var keyword in keywords)
            {
                code = Regex.Replace(code, $@"\b({Regex.Escape(keyword)})\b", "<span class=\"hljs-keyword\">$1</span>", RegexOptions.IgnoreCase);
            }
        }

        return code;
    }

