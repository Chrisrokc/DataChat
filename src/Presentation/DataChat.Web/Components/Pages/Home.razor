    private async Task SaveEditedMessage(ChatMessageDto message)
    {
        if (string.IsNullOrWhiteSpace(_editMessageContent) || _selectedChat == null)
            return;

        try
        {
            // Find the message index
            var messageIndex = _messages.FindIndex(m => m.Id == message.Id);
            if (messageIndex < 0) return;

            // Delete all messages after this one from the database
            var messagesToDelete = _messages.Skip(messageIndex + 1).ToList();
            foreach (var msgToDelete in messagesToDelete)
            {
                var dbMsg = await DbContext.ChatMessages.FindAsync(msgToDelete.Id);
                if (dbMsg != null)
                    DbContext.ChatMessages.Remove(dbMsg);
            }

            // Update the edited message in database
            var editedMsg = await DbContext.ChatMessages.FindAsync(message.Id);
            if (editedMsg != null)
            {
                editedMsg.Content = _editMessageContent;
            }
            await DbContext.SaveChangesAsync();

            // Update local state
            _messages = _messages.Take(messageIndex).ToList();
            _messages.Add(new ChatMessageDto(
                message.Id,
                message.Role,
                _editMessageContent,
                message.CreatedAt,
                null,
                message.Attachments));

            _editingMessageId = null;
            _editMessageContent = "";

            // Regenerate AI response
            await RegenerateFromHistory();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to save edit: {ex.Message}");
        }
    }

    // Regenerate response functionality
    private async Task RegenerateResponse(ChatMessageDto assistantMessage)
    {
        if (_selectedChat == null || _isStreaming) return;

        try
        {
            // Find the assistant message index
            var messageIndex = _messages.FindIndex(m => m.Id == assistantMessage.Id);
            if (messageIndex < 0) return;

            // Delete this message and all after from database
            var messagesToDelete = _messages.Skip(messageIndex).ToList();
            foreach (var msgToDelete in messagesToDelete)
            {
                var dbMsg = await DbContext.ChatMessages.FindAsync(msgToDelete.Id);
                if (dbMsg != null)
                    DbContext.ChatMessages.Remove(dbMsg);
            }
            await DbContext.SaveChangesAsync();

            // Update local state to exclude deleted messages
            _messages = _messages.Take(messageIndex).ToList();
            StateHasChanged();

            // Regenerate AI response
            await RegenerateFromHistory();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to regenerate: {ex.Message}");
        }
    }

    private async Task RegenerateFromHistory()
    {
        if (_selectedChat == null || !_messages.Any()) return;

        _isStreaming = true;
        _streamingContent = "";
        _streamingCts = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            // Build conversation history
            var conversationHistory = _messages
                .Select(m => new ChatMessageDto(m.Id, m.Role, m.Content, m.CreatedAt, null, m.Attachments))
                .ToList();

            // Get RAG context
            string? systemPrompt = null;
            var accessibleDataSourceIds = await CurrentUser.GetAccessibleDataSourceIdsAsync();
            var lastUserMessage = _messages.LastOrDefault(m => m.Role == MessageRole.User);

            // Use selected data sources, filtered by user's access permissions
            var effectiveDataSourceIds = _selectedDataSourceIds.Any()
                ? _selectedDataSourceIds.Intersect(accessibleDataSourceIds).ToList()
                : accessibleDataSourceIds.ToList();

            // Load user memories for context
            var userMemories = await GetUserMemoriesAsync();

            if (effectiveDataSourceIds.Any() && lastUserMessage != null)
            {
                try
                {
                    var queryEmbedding = await EmbeddingService.GenerateEmbeddingAsync(lastUserMessage.Content, _streamingCts.Token);
                    var searchResults = await VectorStore.SearchAsync(queryEmbedding, topK: 5, effectiveDataSourceIds, _streamingCts.Token);

                    if (searchResults.Any())
                    {
                        var ragContext = string.Join("\n\n---\n\n", searchResults.Select(r => r.Content));
                        systemPrompt = "You are a helpful AI assistant with access to organizational documents.\n" +
                            "Use the provided context to answer questions accurately.\n" +
                            "If the context doesn't contain relevant information, say so clearly.\n" +
                            "Always cite which document or section you're referencing when possible.\n\n" +
                            "## Relevant Context:\n" + ragContext;
                    }
                }
                catch { /* Continue without RAG */ }
            }

            // Inject user memories into system prompt
            systemPrompt = BuildSystemPromptWithMemories(systemPrompt, userMemories);

            // Stream response
            var responseBuilder = new System.Text.StringBuilder();
            await foreach (var chunk in AiChatService.StreamResponseAsync(conversationHistory, systemPrompt, _streamingCts.Token))
            {
                responseBuilder.Append(chunk);
                _streamingContent = responseBuilder.ToString();
                StateHasChanged();
            }

            // Save assistant message
            if (!string.IsNullOrEmpty(_streamingContent))
            {
                var assistantMsg = new ChatMessage
                {
                    Id = Guid.NewGuid(),
                    ChatId = _selectedChat.Id,
                    Role = MessageRole.Assistant,
                    Content = _streamingContent,
                    CreatedAt = DateTimeService.UtcNow
                };
                DbContext.ChatMessages.Add(assistantMsg);
                await DbContext.SaveChangesAsync(_streamingCts.Token);

                _messages.Add(new ChatMessageDto(
                    assistantMsg.Id,
                    MessageRole.Assistant,
                    _streamingContent,
                    assistantMsg.CreatedAt));
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            _isStreaming = false;
            _streamingContent = "";
            _streamingCts?.Dispose();
            _streamingCts = null;
            StateHasChanged();
        }
    }

