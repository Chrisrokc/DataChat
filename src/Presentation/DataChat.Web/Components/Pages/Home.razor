    private async Task SendMessage()
    {
        if (_selectedChat == null || (string.IsNullOrWhiteSpace(_userInput) && !_pendingAttachments.Any()))
            return;

        // Close data source dropdown if open
        _showDataSourceDropdown = false;

        var userMessage = _userInput;
        var attachmentsToSend = _pendingAttachments.ToList();
        _userInput = "";
        _pendingAttachments.Clear();
        _isStreaming = true;
        _streamingContent = "";
        _streamingCts = new CancellationTokenSource();

        // Add user message to display immediately (with attachments)
        var userMsgDto = new ChatMessageDto(
            Guid.NewGuid(),
            MessageRole.User,
            userMessage,
            DateTime.UtcNow,
            null,
            attachmentsToSend.Any() ? attachmentsToSend : null);
        _messages.Add(userMsgDto);
        StateHasChanged();

        try
        {
            // Serialize attachments to JSON for storage
            string? attachmentsJson = null;
            if (attachmentsToSend.Any())
            {
                attachmentsJson = JsonSerializer.Serialize(attachmentsToSend);
            }

            // Save user message to database
            var userMsg = new ChatMessage
            {
                Id = Guid.NewGuid(),
                ChatId = _selectedChat.Id,
                Role = MessageRole.User,
                Content = userMessage,
                AttachmentsJson = attachmentsJson,
                CreatedAt = DateTimeService.UtcNow
            };
            DbContext.ChatMessages.Add(userMsg);
            await DbContext.SaveChangesAsync(_streamingCts.Token);

            // Build conversation history for AI (include attachments)
            var conversationHistory = _messages
                .Select(m => new ChatMessageDto(m.Id, m.Role, m.Content, m.CreatedAt, null, m.Attachments))
                .ToList();

            // Get user's accessible data sources and perform RAG
            string? systemPrompt = null;
            var accessibleDataSourceIds = await CurrentUser.GetAccessibleDataSourceIdsAsync();
            var sourceChunks = new List<SourceChunkDto>();

            // Use selected data sources, filtered by user's access permissions
            var effectiveDataSourceIds = _selectedDataSourceIds.Any()
                ? _selectedDataSourceIds.Intersect(accessibleDataSourceIds).ToList()
                : accessibleDataSourceIds.ToList();

            // Load user memories for context
            var userMemories = await GetUserMemoriesAsync();

            if (effectiveDataSourceIds.Any())
            {
                try
                {
                    // Generate embedding for user's question
                    var queryEmbedding = await EmbeddingService.GenerateEmbeddingAsync(userMessage, _streamingCts.Token);

                    // Search for relevant document chunks using selected data sources
                    var searchResults = await VectorStore.SearchAsync(
                        queryEmbedding,
                        topK: 5,
                        effectiveDataSourceIds,
                        _streamingCts.Token);

                    if (searchResults.Any())
                    {
                        var ragContext = string.Join("\n\n---\n\n", searchResults.Select(r => r.Content));

                        // Get document and data source details for source preview
                        var documentIds = searchResults.Select(r => r.DocumentId).Distinct().ToList();
                        var documents = await DbContext.Documents
                            .Where(d => documentIds.Contains(d.Id))
                            .Include(d => d.DataSource)
                            .Select(d => new {
                                d.Id,
                                d.FileName,
                                d.MimeType,
                                d.DataSourceId,
                                DataSourceName = d.DataSource.Name,
                                DataSourceType = d.DataSource.Type
                            })
                            .ToDictionaryAsync(d => d.Id, _streamingCts.Token);

                        // Get admin settings for document access features
                        var config = await DbContext.SystemConfiguration.FirstOrDefaultAsync(_streamingCts.Token);
                        var enableDocumentPreview = config?.EnableDocumentPreview ?? true;
                        var enableDocumentDownload = config?.EnableDocumentDownload ?? true;

                        // Generate message ID for token generation
                        var tempMessageId = Guid.NewGuid();
                        var userId = CurrentUser.UserId!.Value;

                        sourceChunks = searchResults.Select(r =>
                        {
                            var doc = documents.GetValueOrDefault(r.DocumentId);
                            var isFileSystem = doc?.DataSourceType == DataSourceType.FileSystem;

                            // Generate secure tokens only for file-based sources
                            string? viewToken = null;
                            string? downloadToken = null;

                            if (isFileSystem)
                            {
                                if (enableDocumentPreview)
                                    viewToken = TokenService.GenerateToken(r.DocumentId, userId, tempMessageId, isDownload: false);
                                if (enableDocumentDownload)
                                    downloadToken = TokenService.GenerateToken(r.DocumentId, userId, tempMessageId, isDownload: true);
                            }

                            return new SourceChunkDto(
                                ChunkId: r.DocumentChunkId,
                                DocumentId: r.DocumentId,
                                DataSourceId: r.DataSourceId,
                                DocumentName: doc?.FileName ?? "Unknown Document",
                                DataSourceName: doc?.DataSourceName ?? "Unknown Source",
                                Content: r.Content,
                                Score: r.Score,
                                ChunkIndex: null,
                                DataSourceType: doc?.DataSourceType.ToString(),
                                MimeType: doc?.MimeType,
                                ViewToken: viewToken,
                                DownloadToken: downloadToken);
                        }).ToList();

                        // Apply source filtering based on admin settings
                        var minRelevanceDecimal = _sourcePreviewMinRelevance / 100f;
                        sourceChunks = sourceChunks
                            .Where(c => c.Score >= minRelevanceDecimal)
                            .OrderByDescending(c => c.Score)
                            .Take(_sourcePreviewMaxSources)
                            .ToList();

                        systemPrompt = "You are a helpful AI assistant with access to organizational documents.\n" +
                            "Use the provided context to answer questions accurately.\n" +
                            "If the context doesn't contain relevant information, say so clearly.\n" +
                            "Always cite which document or section you're referencing when possible.\n\n" +
                            "## Relevant Context:\n" + ragContext;
                    }
                }
                catch (Exception ex)
                {
                    // Log but don't fail - just proceed without RAG
                    ToastService.ShowWarning($"Note: Could not search documents: {ex.Message}");
                }
            }

            // Inject user memories into system prompt
            systemPrompt = BuildSystemPromptWithMemories(systemPrompt, userMemories);

            // Stream response directly from AI service
            var responseBuilder = new System.Text.StringBuilder();
            await foreach (var chunk in AiChatService.StreamResponseAsync(
                conversationHistory,
                systemPrompt,
                _streamingCts.Token))
            {
                responseBuilder.Append(chunk);
                _streamingContent = responseBuilder.ToString();
                StateHasChanged();
            }

            // Save assistant message
            if (!string.IsNullOrEmpty(_streamingContent))
            {
                var assistantMsg = new ChatMessage
                {
                    Id = Guid.NewGuid(),
                    ChatId = _selectedChat.Id,
                    Role = MessageRole.Assistant,
                    Content = _streamingContent,
                    SourceChunksJson = sourceChunks.Any() ? JsonSerializer.Serialize(sourceChunks) : null,
                    CreatedAt = DateTimeService.UtcNow
                };
                DbContext.ChatMessages.Add(assistantMsg);

                // Update chat title if first message
                var chat = await DbContext.Chats.FindAsync(_selectedChat.Id);
                if (chat != null && chat.Title == "New Chat")
                {
                    chat.Title = userMessage.Length > 50 ? userMessage[..50] + "..." : userMessage;
                    chat.UpdatedAt = DateTimeService.UtcNow;
                }

                await DbContext.SaveChangesAsync(_streamingCts.Token);

                // Add to local messages list with source chunks
                _messages.Add(new ChatMessageDto(
                    assistantMsg.Id,
                    MessageRole.Assistant,
                    _streamingContent,
                    assistantMsg.CreatedAt,
                    null,
                    null,
                    sourceChunks.Any() ? sourceChunks : null));
            }

            // Reload chat list to update titles
            await LoadChats();
        }
        catch (OperationCanceledException)
        {
            // User cancelled - that's okay
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            _isStreaming = false;
            _streamingContent = "";
            _streamingCts?.Dispose();
            _streamingCts = null;
            StateHasChanged();
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles(MaxFiles);

        foreach (var file in files)
        {
            // Check file count limit
            if (_pendingAttachments.Count >= MaxFiles)
            {
                ToastService.ShowWarning($"Maximum {MaxFiles} files allowed per message.");
                break;
            }

            // Validate file type
            if (!IsAllowedFileType(file.ContentType))
            {
                ToastService.ShowError($"'{file.Name}' is not a supported file type. Use images (JPG, PNG, GIF, WebP) or documents (PDF, Excel, CSV, TXT, MD, JSON).");
                continue;
            }

            // Validate file size
            if (file.Size > MaxFileSize)
            {
                ToastService.ShowError($"'{file.Name}' exceeds the 20MB size limit.");
                continue;
            }

            try
            {
                // Read file to base64
                using var stream = file.OpenReadStream(MaxFileSize);
                using var memoryStream = new MemoryStream();
                await stream.CopyToAsync(memoryStream);
                var base64 = Convert.ToBase64String(memoryStream.ToArray());

                var attachment = new MessageAttachmentDto(
                    file.Name,
                    file.ContentType,
                    base64,
                    file.Size);

                _pendingAttachments.Add(attachment);
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Failed to read '{file.Name}': {ex.Message}");
            }
        }

        StateHasChanged();
    }

