    private static string GetDocumentIconColor(string mimeType) =>
        mimeType.ToLowerInvariant() switch
        {
            "application/pdf" => "#d13438",  // Red for PDF
            "text/csv" => "#107c10",          // Green for CSV
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" => "#217346",  // Excel green for XLSX
            "application/vnd.ms-excel" => "#217346",  // Excel green for XLS
            "application/json" => "#ffb900",  // Yellow for JSON
            _ => "#0078d4"                    // Blue for others
        };

    private static string GetTruncatedFileName(string fileName)
    {
        if (fileName.Length <= 20) return fileName;
        var ext = Path.GetExtension(fileName);
        var name = Path.GetFileNameWithoutExtension(fileName);
        if (name.Length > 15)
            name = name[..12] + "...";
        return name + ext;
    }

    private static string GetFileExtension(string fileName) =>
        Path.GetExtension(fileName).TrimStart('.').ToUpperInvariant();

    private static string FormatTimestamp(DateTime utcTime)
    {
        var localTime = utcTime.ToLocalTime();
        var today = DateTime.Today;
        var yesterday = today.AddDays(-1);

        if (localTime.Date == today)
            return $"Today at {localTime:h:mm tt}";
        if (localTime.Date == yesterday)
            return $"Yesterday at {localTime:h:mm tt}";
        if (localTime.Year == today.Year)
            return localTime.ToString("MMM d 'at' h:mm tt");
        return localTime.ToString("MMM d, yyyy 'at' h:mm tt");
    }

