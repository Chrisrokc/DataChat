    // User Memory Methods
    private async Task<List<UserMemory>> GetUserMemoriesAsync()
    {
        try
        {
            var userId = CurrentUser.UserId;
            if (userId == null) return new List<UserMemory>();

            return await DbContext.UserMemories
                .Where(m => m.UserId == userId.Value && m.IsActive)
                .OrderByDescending(m => m.Priority)
                .ThenBy(m => m.Category)
                .ToListAsync();
        }
        catch
        {
            return new List<UserMemory>();
        }
    }

    private string? BuildSystemPromptWithMemories(string? basePrompt, List<UserMemory> memories)
    {
        if (!memories.Any())
            return basePrompt;

        var memorySection = new System.Text.StringBuilder();
        memorySection.AppendLine("## User Preferences & Context");
        memorySection.AppendLine("The following are things to remember about this user. Apply these preferences and context to all responses:");
        memorySection.AppendLine();

        // Group memories by category
        var groupedMemories = memories.GroupBy(m => m.Category);
        foreach (var group in groupedMemories)
        {
            var categoryName = group.Key switch
            {
                "preference" => "Preferences",
                "fact" => "Facts About User",
                "instruction" => "Instructions",
                "context" => "Context",
                _ => "General"
            };

            memorySection.AppendLine($"### {categoryName}");
            foreach (var memory in group)
            {
                memorySection.AppendLine($"- {memory.Content}");
            }
            memorySection.AppendLine();
        }

        if (string.IsNullOrEmpty(basePrompt))
        {
            return "You are a helpful AI assistant.\n\n" + memorySection.ToString();
        }

        return basePrompt + "\n\n" + memorySection.ToString();
    }

    // Folder Methods
    private async Task LoadFolders()
    {
        try
        {
            var userId = CurrentUser.UserId;
            if (userId != null)
            {
                _folders = await DbContext.ChatFolders
                    .Where(f => f.UserId == userId.Value)
                    .OrderBy(f => f.SortOrder)
                    .ThenBy(f => f.Name)
                    .ToListAsync();

                // Expand all folders by default
                _expandedFolderIds = new HashSet<Guid>(_folders.Select(f => f.Id));
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load folders: {ex.Message}");
        }
    }

    private void ToggleFolder(Guid folderId)
    {
        if (_expandedFolderIds.Contains(folderId))
        {
            _expandedFolderIds.Remove(folderId);
        }
        else
        {
            _expandedFolderIds.Add(folderId);
        }
    }

    private void ShowAddFolderDialog()
    {
        _showFolderDialog = true;
        _newFolderName = "";
        _newFolderColor = "#0078d4";
    }

    private void CloseFolderDialog()
    {
        _showFolderDialog = false;
    }

    private async Task CreateFolder()
    {
        if (string.IsNullOrWhiteSpace(_newFolderName)) return;

        try
        {
            var userId = CurrentUser.UserId;
            if (userId == null) return;

            var folder = new ChatFolder
            {
                Id = Guid.NewGuid(),
                UserId = userId.Value,
                Name = _newFolderName.Trim(),
                Color = _newFolderColor,
                SortOrder = _folders.Count,
                CreatedAt = DateTimeService.UtcNow
            };

            DbContext.ChatFolders.Add(folder);
            await DbContext.SaveChangesAsync();

            _folders.Add(folder);
            _expandedFolderIds.Add(folder.Id);
            _showFolderDialog = false;
            ToastService.ShowSuccess($"Folder '{folder.Name}' created");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to create folder: {ex.Message}");
        }
    }

    private async Task DeleteFolder(ChatFolder folder)
    {
        try
        {
            // Move all chats out of the folder first
            var chatsInFolder = await DbContext.Chats
                .Where(c => c.FolderId == folder.Id)
                .ToListAsync();

            foreach (var chat in chatsInFolder)
            {
                chat.FolderId = null;
            }

            DbContext.ChatFolders.Remove(folder);
            await DbContext.SaveChangesAsync();

            _folders.Remove(folder);
            _expandedFolderIds.Remove(folder.Id);
            await LoadChats(); // Reload to update folder assignments
            ToastService.ShowSuccess($"Folder '{folder.Name}' deleted");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to delete folder: {ex.Message}");
        }
    }

    private void StartRenameFolder(ChatFolder folder)
    {
        _renamingFolderId = folder.Id;
        _renameFolderName = folder.Name;
    }

    private async Task SaveRenamedFolder(ChatFolder folder)
    {
        if (string.IsNullOrWhiteSpace(_renameFolderName))
        {
            _renamingFolderId = null;
            return;
        }

        try
        {
            folder.Name = _renameFolderName.Trim();
            folder.UpdatedAt = DateTimeService.UtcNow;
            await DbContext.SaveChangesAsync();
            ToastService.ShowSuccess("Folder renamed");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to rename: {ex.Message}");
        }

        _renamingFolderId = null;
        _renameFolderName = "";
    }

    private async Task HandleFolderRenameKeyDown(KeyboardEventArgs args, ChatFolder folder)
    {
        if (args.Key == "Enter")
        {
            await SaveRenamedFolder(folder);
        }
        else if (args.Key == "Escape")
        {
            _renamingFolderId = null;
            _renameFolderName = "";
        }
    }

    private void ToggleMoveMenu(Guid chatId)
    {
        if (_movingChatId == chatId)
        {
            _movingChatId = null;
        }
        else
        {
            _movingChatId = chatId;
        }
    }

    private async Task MoveChatToFolder(ChatDto chat, Guid? folderId)
    {
        try
        {
            var chatEntity = await DbContext.Chats.FindAsync(chat.Id);
            if (chatEntity != null)
            {
                chatEntity.FolderId = folderId;
                chatEntity.UpdatedAt = DateTimeService.UtcNow;
                await DbContext.SaveChangesAsync();

                // Update local state
                var chatIndex = _chats.FindIndex(c => c.Id == chat.Id);
                if (chatIndex >= 0)
                {
                    _chats[chatIndex] = chat with { FolderId = folderId };
                }
                if (_selectedChat?.Id == chat.Id)
                {
                    _selectedChat = _selectedChat with { FolderId = folderId };
                }

                FilterChats();

                var folderName = folderId.HasValue
                    ? _folders.FirstOrDefault(f => f.Id == folderId)?.Name ?? "folder"
                    : null;

                if (folderName != null)
                {
                    ToastService.ShowSuccess($"Moved to '{folderName}'");
                }
                else
                {
                    ToastService.ShowInfo("Removed from folder");
                }
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to move: {ex.Message}");
        }
        finally
        {
            _movingChatId = null;
        }
    }

    // Message Reaction Methods
    private string GetReactionClass(Guid messageId, string reactionType)
    {
        if (_messageReactions.TryGetValue(messageId, out var existingReaction))
        {
            if (existingReaction == reactionType)
            {
                return reactionType == "thumbs_up" ? "active-positive" : "active-negative";
            }
        }
        return "";
    }

    private async Task ToggleReaction(Guid messageId, string reactionType)
    {
        try
        {
            var userId = CurrentUser.UserId;
            if (!userId.HasValue) return;

            // Check if reaction exists for this message
            var existingReaction = await DbContext.MessageReactions
                .FirstOrDefaultAsync(r => r.MessageId == messageId && r.UserId == userId.Value);

            if (existingReaction != null)
            {
                if (existingReaction.ReactionType == reactionType)
                {
                    // Remove reaction (toggle off)
                    DbContext.MessageReactions.Remove(existingReaction);
                    await DbContext.SaveChangesAsync();
                    _messageReactions.Remove(messageId);
                }
                else
                {
                    // If changing from thumbs_up to thumbs_down, show feedback dialog
                    if (reactionType == "thumbs_down")
                    {
                        _feedbackMessageId = messageId;
                        _feedbackCategory = "";
                        _feedbackText = "";
                        _showFeedbackDialog = true;
                        return;
                    }

                    // Change reaction type to thumbs_up
                    existingReaction.ReactionType = reactionType;
                    existingReaction.FeedbackCategory = null;
                    existingReaction.FeedbackText = null;
                    existingReaction.UpdatedBy = CurrentUser.WindowsIdentity;
                    await DbContext.SaveChangesAsync();
                    _messageReactions[messageId] = reactionType;
                }
            }
            else
            {
                // Create new reaction
                if (reactionType == "thumbs_down")
                {
                    // Show feedback dialog for negative reactions
                    _feedbackMessageId = messageId;
                    _feedbackCategory = "";
                    _feedbackText = "";
                    _showFeedbackDialog = true;
                    return;
                }

                // Create thumbs up directly
                var newReaction = new MessageReaction
                {
                    Id = Guid.NewGuid(),
                    MessageId = messageId,
                    UserId = userId.Value,
                    ReactionType = reactionType,
                    CreatedBy = CurrentUser.WindowsIdentity,
                    CreatedAt = DateTimeService.UtcNow
                };

                DbContext.MessageReactions.Add(newReaction);
                await DbContext.SaveChangesAsync();
                _messageReactions[messageId] = reactionType;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to save reaction: {ex.Message}");
        }
    }

    private async Task SubmitFeedback()
    {
        if (!_feedbackMessageId.HasValue) return;

        try
        {
            var userId = CurrentUser.UserId;
            if (!userId.HasValue) return;

            // Check if reaction already exists
            var existingReaction = await DbContext.MessageReactions
                .FirstOrDefaultAsync(r => r.MessageId == _feedbackMessageId.Value && r.UserId == userId.Value);

            if (existingReaction != null)
            {
                // Update existing reaction
                existingReaction.ReactionType = "thumbs_down";
                existingReaction.FeedbackCategory = string.IsNullOrWhiteSpace(_feedbackCategory) ? null : _feedbackCategory;
                existingReaction.FeedbackText = string.IsNullOrWhiteSpace(_feedbackText) ? null : _feedbackText;
                existingReaction.UpdatedBy = CurrentUser.WindowsIdentity;
            }
            else
            {
                // Create new negative reaction
                var newReaction = new MessageReaction
                {
                    Id = Guid.NewGuid(),
                    MessageId = _feedbackMessageId.Value,
                    UserId = userId.Value,
                    ReactionType = "thumbs_down",
                    FeedbackCategory = string.IsNullOrWhiteSpace(_feedbackCategory) ? null : _feedbackCategory,
                    FeedbackText = string.IsNullOrWhiteSpace(_feedbackText) ? null : _feedbackText,
                    CreatedBy = CurrentUser.WindowsIdentity,
                    CreatedAt = DateTimeService.UtcNow
                };

                DbContext.MessageReactions.Add(newReaction);
            }

            await DbContext.SaveChangesAsync();
            _messageReactions[_feedbackMessageId.Value] = "thumbs_down";

            ToastService.ShowSuccess("Thank you for your feedback!");
            CloseFeedbackDialog();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to save feedback: {ex.Message}");
        }
    }

    private void CloseFeedbackDialog()
    {
        _showFeedbackDialog = false;
        _feedbackMessageId = null;
        _feedbackCategory = "";
        _feedbackText = "";
        StateHasChanged();
    }

    private void ShowSourcePreview(IEnumerable<SourceChunkDto> sourceChunks)
    {
        _previewSourceChunks = sourceChunks;
        _showSourcePreviewDialog = true;
        StateHasChanged();
    }

    private void CloseSourcePreview()
    {
        _showSourcePreviewDialog = false;
        _previewSourceChunks = null;
        StateHasChanged();
    }

    private MarkupString GetFileTypeIcon(string mimeType)
    {
        // Return appropriate SVG icon based on MIME type
        return mimeType?.ToLowerInvariant() switch
        {
            "application/pdf" => new MarkupString("<svg viewBox='0 0 20 20' fill='#e74c3c'><path d='M4 2h8l4 4v12a2 2 0 01-2 2H4a2 2 0 01-2-2V4a2 2 0 012-2zm7 0v5h5'/></svg>"),
            "application/msword" or "application/vnd.openxmlformats-officedocument.wordprocessingml.document" =>
                new MarkupString("<svg viewBox='0 0 20 20' fill='#2980b9'><path d='M4 2h8l4 4v12a2 2 0 01-2 2H4a2 2 0 01-2-2V4a2 2 0 012-2zm7 0v5h5'/></svg>"),
            "text/plain" or "text/csv" or "text/markdown" =>
                new MarkupString("<svg viewBox='0 0 20 20' fill='#666'><path d='M4 2h8l4 4v12a2 2 0 01-2 2H4a2 2 0 01-2-2V4a2 2 0 012-2zm7 0v5h5M5 9h10M5 12h10M5 15h6'/></svg>"),
            _ => new MarkupString("<svg viewBox='0 0 20 20' fill='#888'><path d='M4 2h8l4 4v12a2 2 0 01-2 2H4a2 2 0 01-2-2V4a2 2 0 012-2zm7 0v5h5'/></svg>")
        };
    }

    private string GetCategoryLabel(string category) => category switch
    {
        "incorrect" => "Factually incorrect or misleading",
        "incomplete" => "Incomplete or missing information",
        "harmful" => "Potentially harmful or inappropriate",
        "off_topic" => "Didn't address my question",
        "other" => "Other issue",
        _ => category
    };

    private async Task LoadMessageReactions()
    {
        if (_selectedChat == null) return;

        try
        {
            var userId = CurrentUser.UserId;
            if (!userId.HasValue) return;

            // Get message IDs for current chat
            var messageIds = _messages.Select(m => m.Id).ToList();

            // Load user's reactions for these messages
            var reactions = await DbContext.MessageReactions
                .Where(r => r.UserId == userId.Value && messageIds.Contains(r.MessageId))
                .ToDictionaryAsync(r => r.MessageId, r => r.ReactionType);

            _messageReactions = reactions;
        }
        catch
        {
            // Silent fail - reactions are non-critical
            _messageReactions = new Dictionary<Guid, string>();
        }
    }
