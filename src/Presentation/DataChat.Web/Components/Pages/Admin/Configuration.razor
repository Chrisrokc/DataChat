@code {
    private SystemConfiguration? _config;
    private string _apiKey = "";
    private bool _showApiKey;
    private bool _hasExistingApiKey;
    private float _temperature = 0.7f;
    private bool _isTesting;

    // Test status display
    private string _testStatus = "";
    private bool _chatTestPassed;
    private bool _embeddingTestPassed;
    private string _chatTestResult = "";
    private string _embeddingTestResult = "";

    // Azure OpenAI fields
    private string _azureApiKey = "";
    private bool _showAzureApiKey;
    private bool _hasExistingAzureApiKey;

    // SQL Server fields
    private string _sqlPassword = "";
    private bool _showSqlPassword;
    private bool _hasExistingSqlPassword;
    private bool _isSavingSql;
    private bool _isTestingSql;
    private string _sqlConnectionStatus = "";
    private MessageIntent _sqlConnectionStatusIntent = MessageIntent.Info;

    // RAG settings
    private bool _isSavingRag;

    // Authentication settings
    private bool _isSavingAuth;

    // Status dashboard
    private ConfigStatus _sqlStatus = ConfigStatus.Unknown;
    private ConfigStatus _chatModelStatus = ConfigStatus.Unknown;
    private ConfigStatus _embeddingModelStatus = ConfigStatus.Unknown;
    private ConfigStatus _ragStatus = ConfigStatus.Unknown;
    private ConfigStatus _authStatus = ConfigStatus.Unknown;
    private string _sqlStatusMessage = "Checking...";
    private string _chatModelStatusMessage = "Checking...";
    private string _embeddingModelStatusMessage = "Checking...";
    private string _ragStatusMessage = "Checking...";
    private string _authStatusMessage = "Checking...";
    private bool _isCheckingStatus;

    private enum ConfigStatus { Unknown, Success, Warning, Error }

    // Model lists per provider
    private readonly string[] _openAiChatModels = { "gpt-4o", "gpt-4o-mini", "gpt-4-turbo", "gpt-3.5-turbo" };
    private readonly string[] _openAiEmbeddingModels = { "text-embedding-3-small", "text-embedding-3-large", "text-embedding-ada-002" };

    // Ollama models fetched from server
    private List<string> _ollamaAvailableModels = new();
    private bool _isFetchingOllamaModels;

    protected override async Task OnInitializedAsync()
    {
        await LoadConfiguration();
        // Fire and forget - don't block page load
        _ = CheckAllStatus();
    }

    private async Task LoadConfiguration()
    {
        _config = await DbContext.SystemConfiguration.FirstOrDefaultAsync();

        if (_config == null)
        {
            _config = new SystemConfiguration();
            DbContext.SystemConfiguration.Add(_config);
            await DbContext.SaveChangesAsync();
        }

        _temperature = (float)_config.Temperature;
        _hasExistingApiKey = !string.IsNullOrEmpty(_config.OpenAiApiKey);
        _hasExistingAzureApiKey = !string.IsNullOrEmpty(_config.AzureOpenAiApiKey);
        _hasExistingSqlPassword = !string.IsNullOrEmpty(_config.SqlServerPassword);
    }

    private string BuildSqlConnectionString(string? passwordOverride = null)
    {
        if (_config == null) return "";

        var builder = new SqlConnectionStringBuilder
        {
            DataSource = string.IsNullOrEmpty(_config.SqlServerHost)
                ? ""
                : (_config.SqlServerPort != 1433 ? $"{_config.SqlServerHost},{_config.SqlServerPort}" : _config.SqlServerHost),
            InitialCatalog = _config.SqlServerDatabase ?? "",
            ConnectTimeout = _config.SqlServerConnectionTimeout,
            TrustServerCertificate = _config.SqlServerTrustServerCertificate
        };

        if (_config.SqlServerUseIntegratedSecurity)
        {
            builder.IntegratedSecurity = true;
        }
        else
        {
            builder.UserID = _config.SqlServerUsername ?? "";
            // Use override password or decrypt existing
            if (!string.IsNullOrWhiteSpace(passwordOverride))
            {
                builder.Password = passwordOverride;
            }
            else if (!string.IsNullOrEmpty(_config.SqlServerPassword))
            {
                try
                {
                    var decryptedPassword = SecureConfig.Decrypt(_config.SqlServerPassword);
                    // If decryption failed silently (returned ciphertext), the value will be too long
                    // SqlConnectionStringBuilder has a 128 char limit for passwords
                    if (decryptedPassword.Length <= 128)
                    {
                        builder.Password = decryptedPassword;
                    }
                    else
                    {
                        // Decryption likely failed - password is still encrypted
                        builder.Password = "";
                    }
                }
                catch
                {
                    builder.Password = "";
                }
            }
        }

        return builder.ConnectionString;
    }

    private async Task TestSqlConnection()
    {
        _isTestingSql = true;
        _sqlConnectionStatus = "";

        try
        {
            if (string.IsNullOrWhiteSpace(_config?.SqlServerHost))
            {
                _sqlConnectionStatus = "Please enter a server host/IP address";
                _sqlConnectionStatusIntent = MessageIntent.Warning;
                return;
            }

            if (string.IsNullOrWhiteSpace(_config.SqlServerDatabase))
            {
                _sqlConnectionStatus = "Please enter a database name";
                _sqlConnectionStatusIntent = MessageIntent.Warning;
                return;
            }

            // Build connection string with form password if provided
            var connectionString = BuildSqlConnectionString(
                !string.IsNullOrWhiteSpace(_sqlPassword) ? _sqlPassword : null);

            await using var connection = new SqlConnection(connectionString);
            await connection.OpenAsync();

            // Get server version and database info
            await using var cmd = new SqlCommand(
                "SELECT @@VERSION as Version, DB_NAME() as DatabaseName, SUSER_NAME() as CurrentUser",
                connection);
            await using var reader = await cmd.ExecuteReaderAsync();

            if (await reader.ReadAsync())
            {
                var version = reader["Version"]?.ToString()?.Split('\n')[0] ?? "Unknown";
                var dbName = reader["DatabaseName"]?.ToString() ?? "Unknown";
                var currentUser = reader["CurrentUser"]?.ToString() ?? "Unknown";

                _sqlConnectionStatus = $"Connected successfully!\n" +
                    $"Server: {version}\n" +
                    $"Database: {dbName}\n" +
                    $"User: {currentUser}";
                _sqlConnectionStatusIntent = MessageIntent.Success;
            }
        }
        catch (Exception ex)
        {
            _sqlConnectionStatus = $"Connection failed: {ex.Message}";
            _sqlConnectionStatusIntent = MessageIntent.Error;
            Logger.LogError(ex, "SQL Server connection test failed");
        }
        finally
        {
            _isTestingSql = false;
        }
    }

    private async Task SaveSqlSettings()
    {
        if (_config == null) return;

        _isSavingSql = true;
        try
        {
            // Encrypt password if provided
            if (!string.IsNullOrWhiteSpace(_sqlPassword))
            {
                _config.SqlServerPassword = SecureConfig.Encrypt(_sqlPassword);
                _hasExistingSqlPassword = true;
            }

            _config.UpdatedAt = DateTime.UtcNow;
            await DbContext.SaveChangesAsync();

            ToastService.ShowSuccess("SQL Server settings saved successfully!");
            _sqlPassword = ""; // Clear password field
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save SQL configuration");
            ToastService.ShowError($"Failed to save settings: {ex.Message}");
        }
        finally
        {
            _isSavingSql = false;
        }
    }

    private async Task TestAndSaveSettings()
    {
        if (_config == null) return;

        _isTesting = true;
        _testStatus = "";
        _chatTestPassed = false;
        _embeddingTestPassed = false;
        _chatTestResult = "";
        _embeddingTestResult = "";

        try
        {
            // 1. Validate configuration based on provider
            if (!ValidateConfiguration())
                return;

            // 2. Save configuration first (services read from DB)
            _testStatus = "Saving configuration...";
            StateHasChanged();

            // Save API keys if provided
            if (!string.IsNullOrWhiteSpace(_apiKey))
            {
                _config.OpenAiApiKey = SecureConfig.Encrypt(_apiKey);
                _hasExistingApiKey = true;
            }
            if (!string.IsNullOrWhiteSpace(_azureApiKey))
            {
                _config.AzureOpenAiApiKey = SecureConfig.Encrypt(_azureApiKey);
                _hasExistingAzureApiKey = true;
            }

            _config.Temperature = (decimal)_temperature;
            _config.UpdatedAt = DateTime.UtcNow;
            await DbContext.SaveChangesAsync();

            // 3. Test chat model
            _testStatus = "Testing chat model...";
            StateHasChanged();

            try
            {
                var chatService = AiServiceFactory.GetChatService();
                var messages = new List<ChatMessageDto>
                {
                    new(Guid.NewGuid(), DataChat.Domain.Enums.MessageRole.User,
                        "Hello! Can you confirm you're working correctly?",
                        DateTime.UtcNow)
                };

                var responseBuilder = new System.Text.StringBuilder();
                await foreach (var chunk in chatService.StreamResponseAsync(messages, null, CancellationToken.None))
                {
                    responseBuilder.Append(chunk);
                }

                if (string.IsNullOrWhiteSpace(responseBuilder.ToString()))
                    throw new Exception("Empty response received");

                _chatTestPassed = true;
                _chatTestResult = "Chat model responded successfully";
            }
            catch (Exception ex)
            {
                _chatTestResult = $"Chat test failed: {ex.Message}";
                Logger.LogError(ex, "Chat model test failed");
            }

            StateHasChanged();

            // 4. Test embedding model
            _testStatus = "Testing embedding model...";
            StateHasChanged();

            try
            {
                var embeddingService = AiServiceFactory.GetEmbeddingService();
                var embedding = await embeddingService.GenerateEmbeddingAsync("Test embedding");

                if (embedding == null || embedding.Length == 0)
                    throw new Exception("Empty embedding received");

                _embeddingTestPassed = true;
                _embeddingTestResult = $"Embedding generated ({embedding.Length} dimensions)";
            }
            catch (Exception ex)
            {
                _embeddingTestResult = $"Embedding test failed: {ex.Message}";
                Logger.LogError(ex, "Embedding model test failed");
            }

            // 5. Show final status
            if (_chatTestPassed && _embeddingTestPassed)
            {
                _testStatus = "All tests passed! Settings saved successfully.";
                ToastService.ShowSuccess("Configuration saved and verified!");
                _apiKey = "";
                _azureApiKey = "";
            }
            else
            {
                _testStatus = "Some tests failed. Settings saved but may not work correctly.";
                ToastService.ShowWarning("Settings saved but some tests failed. Please check the configuration.");
            }
        }
        catch (Exception ex)
        {
            _testStatus = $"Error: {ex.Message}";
            Logger.LogError(ex, "Failed to test and save settings");
            ToastService.ShowError($"Failed: {ex.Message}");
        }
        finally
        {
            _isTesting = false;
        }
    }

    private bool ValidateConfiguration()
    {
        if (_config == null) return false;

        switch (_config.LlmProvider)
        {
            case LlmProvider.OpenAI:
                var apiKeyToTest = !string.IsNullOrWhiteSpace(_apiKey)
                    ? _apiKey
                    : (_config.OpenAiApiKey != null ? SecureConfig.Decrypt(_config.OpenAiApiKey) : null);

                if (string.IsNullOrWhiteSpace(apiKeyToTest))
                {
                    ToastService.ShowWarning("Please enter an OpenAI API key first");
                    return false;
                }
                break;

            case LlmProvider.AzureOpenAI:
                if (string.IsNullOrWhiteSpace(_config.AzureOpenAiEndpoint))
                {
                    ToastService.ShowWarning("Please enter an Azure OpenAI endpoint");
                    return false;
                }

                var azureKey = !string.IsNullOrWhiteSpace(_azureApiKey)
                    ? _azureApiKey
                    : (_config.AzureOpenAiApiKey != null ? SecureConfig.Decrypt(_config.AzureOpenAiApiKey) : null);

                if (string.IsNullOrWhiteSpace(azureKey))
                {
                    ToastService.ShowWarning("Please enter an Azure OpenAI API key");
                    return false;
                }

                if (string.IsNullOrWhiteSpace(_config.AzureOpenAiDeploymentName))
                {
                    ToastService.ShowWarning("Please enter an Azure OpenAI chat deployment name");
                    return false;
                }

                if (string.IsNullOrWhiteSpace(_config.AzureOpenAiEmbeddingDeployment))
                {
                    ToastService.ShowWarning("Please enter an Azure OpenAI embedding deployment name");
                    return false;
                }
                break;

            case LlmProvider.Ollama:
                if (string.IsNullOrWhiteSpace(_config.OllamaEndpoint))
                {
                    ToastService.ShowWarning("Please enter an Ollama endpoint");
                    return false;
                }

                if (string.IsNullOrWhiteSpace(_config.OllamaModel))
                {
                    ToastService.ShowWarning("Please enter an Ollama chat model");
                    return false;
                }

                if (string.IsNullOrWhiteSpace(_config.OllamaEmbeddingModel))
                {
                    ToastService.ShowWarning("Please enter an Ollama embedding model");
                    return false;
                }
                break;
        }

        return true;
    }

    private async Task FetchOllamaModels()
    {
        if (_config == null || string.IsNullOrWhiteSpace(_config.OllamaEndpoint))
        {
            ToastService.ShowWarning("Please enter an Ollama endpoint first");
            return;
        }

        _isFetchingOllamaModels = true;
        try
        {
            using var httpClient = new HttpClient { Timeout = TimeSpan.FromSeconds(10) };
            var response = await httpClient.GetAsync($"{_config.OllamaEndpoint}/api/tags");

            if (!response.IsSuccessStatusCode)
            {
                ToastService.ShowError($"Failed to fetch models: {response.StatusCode}");
                return;
            }

            var json = await response.Content.ReadAsStringAsync();
            var doc = System.Text.Json.JsonDocument.Parse(json);

            _ollamaAvailableModels.Clear();

            if (doc.RootElement.TryGetProperty("models", out var modelsArray))
            {
                foreach (var model in modelsArray.EnumerateArray())
                {
                    if (model.TryGetProperty("name", out var nameElement))
                    {
                        var modelName = nameElement.GetString();
                        if (!string.IsNullOrEmpty(modelName))
                        {
                            _ollamaAvailableModels.Add(modelName);
                        }
                    }
                }
            }

            if (_ollamaAvailableModels.Any())
            {
                // If current model is not in the list, set to first available
                if (!_ollamaAvailableModels.Contains(_config.OllamaModel))
                {
                    _config.OllamaModel = _ollamaAvailableModels.First();
                }
                if (!_ollamaAvailableModels.Contains(_config.OllamaEmbeddingModel))
                {
                    _config.OllamaEmbeddingModel = _ollamaAvailableModels.First();
                }

                ToastService.ShowSuccess($"Found {_ollamaAvailableModels.Count} model(s) on Ollama server");
            }
            else
            {
                ToastService.ShowWarning("No models found on Ollama server. Pull a model with 'ollama pull <model>'");
            }
        }
        catch (HttpRequestException)
        {
            ToastService.ShowError("Cannot reach Ollama server. Make sure it's running.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to fetch Ollama models");
            ToastService.ShowError($"Failed to fetch models: {ex.Message}");
        }
        finally
        {
            _isFetchingOllamaModels = false;
        }
    }

