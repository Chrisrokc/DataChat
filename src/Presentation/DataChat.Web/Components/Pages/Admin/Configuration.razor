@page "/admin/configuration"
@attribute [Authorize(Policy = "AdminOnly")]
@using Microsoft.Data.SqlClient
@using DataChat.Domain.Enums
@using DataChat.Infrastructure.AI
@inject IApplicationDbContext DbContext
@inject ISecureConfigurationService SecureConfig
@inject IAiServiceFactory AiServiceFactory
@inject IToastService ToastService
@inject ILogger<Configuration> Logger

<PageTitle>System Configuration</PageTitle>

<h4 style="margin-bottom: 16px;">System Configuration</h4>

<FluentTabs>
    <FluentTab Label="Status" Id="status-overview">
        <FluentCard Style="padding: 16px; margin-top: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <h5 style="margin: 0;">Configuration Status</h5>
                <FluentButton Appearance="Appearance.Outline" OnClick="CheckAllStatus" Disabled="_isCheckingStatus">
                    @if (_isCheckingStatus)
                    {
                        <FluentProgressRing Style="width: 16px; height: 16px; margin-right: 8px;" />
                    }
                    Refresh Status
                </FluentButton>
            </div>

            <FluentGrid Spacing="3">
                <FluentGridItem xs="12" sm="6">
                    <FluentCard Style="padding: 16px;">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            @(RenderStatusIcon(_sqlStatus))
                            <div>
                                <div style="font-weight: 500;">SQL Server</div>
                                <div style="font-size: 12px; color: gray;">@_sqlStatusMessage</div>
                            </div>
                        </div>
                    </FluentCard>
                </FluentGridItem>

                <FluentGridItem xs="12" sm="6">
                    <FluentCard Style="padding: 16px;">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            @(RenderStatusIcon(_chatModelStatus))
                            <div>
                                <div style="font-weight: 500;">Chat Model (@(_config?.LlmProvider.ToString() ?? "Not Set"))</div>
                                <div style="font-size: 12px; color: gray;">@_chatModelStatusMessage</div>
                            </div>
                        </div>
                    </FluentCard>
                </FluentGridItem>

                <FluentGridItem xs="12" sm="6">
                    <FluentCard Style="padding: 16px;">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            @(RenderStatusIcon(_embeddingModelStatus))
                            <div>
                                <div style="font-weight: 500;">Embedding Model</div>
                                <div style="font-size: 12px; color: gray;">@_embeddingModelStatusMessage</div>
                            </div>
                        </div>
                    </FluentCard>
                </FluentGridItem>

                <FluentGridItem xs="12" sm="6">
                    <FluentCard Style="padding: 16px;">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            @(RenderStatusIcon(_ragStatus))
                            <div>
                                <div style="font-weight: 500;">RAG Settings</div>
                                <div style="font-size: 12px; color: gray;">@_ragStatusMessage</div>
                            </div>
                        </div>
                    </FluentCard>
                </FluentGridItem>

                <FluentGridItem xs="12" sm="6">
                    <FluentCard Style="padding: 16px;">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            @(RenderStatusIcon(_authStatus))
                            <div>
                                <div style="font-weight: 500;">Authentication</div>
                                <div style="font-size: 12px; color: gray;">@_authStatusMessage</div>
                            </div>
                        </div>
                    </FluentCard>
                </FluentGridItem>
            </FluentGrid>
        </FluentCard>
    </FluentTab>

    <FluentTab Label="SQL Server" Id="sql-settings">
        @if (_config != null)
        {
            <FluentCard Style="padding: 16px; margin-top: 16px;">
                <FluentMessageBar Intent="@MessageIntent.Warning" Style="margin-bottom: 16px;">
                    <strong>Requires SQL Server 2025 or later.</strong> This application uses native VECTOR data types for embedding storage, which are only available in SQL Server 2025+.
                </FluentMessageBar>

                <FluentGrid Spacing="3">
                    <FluentGridItem xs="12" sm="8">
                        <FluentTextField @bind-Value="_config.SqlServerHost"
                                        Label="Server Host / IP Address"
                                        Placeholder="e.g., 192.168.1.100 or sqlserver.domain.com"
                                        Style="width: 100%;" />
                    </FluentGridItem>

                    <FluentGridItem xs="12" sm="4">
                        <FluentNumberField @bind-Value="_config.SqlServerPort"
                                          Label="Port"
                                          Min="1" Max="65535"
                                          Style="width: 100%;" />
                    </FluentGridItem>

                    <FluentGridItem xs="12" sm="6">
                        <FluentTextField @bind-Value="_config.SqlServerDatabase"
                                        Label="Database Name"
                                        Placeholder="e.g., DataChat"
                                        Style="width: 100%;" />
                    </FluentGridItem>

                    <FluentGridItem xs="12" sm="6">
                        <FluentNumberField @bind-Value="_config.SqlServerConnectionTimeout"
                                          Label="Connection Timeout (seconds)"
                                          Min="5" Max="300"
                                          Style="width: 100%;" />
                    </FluentGridItem>

                    <FluentGridItem xs="12">
                        <FluentCheckbox @bind-Value="_config.SqlServerUseIntegratedSecurity"
                                       Label="Use Windows Integrated Security (trusted connection)" />
                    </FluentGridItem>

                    @if (!_config.SqlServerUseIntegratedSecurity)
                    {
                        <FluentGridItem xs="12" sm="6">
                            <FluentTextField @bind-Value="_config.SqlServerUsername"
                                            Label="Username"
                                            Placeholder="e.g., sa"
                                            Style="width: 100%;" />
                        </FluentGridItem>

                        <FluentGridItem xs="12" sm="6">
                            <FluentTextField @bind-Value="_sqlPassword"
                                            Label="Password"
                                            TextFieldType="@(_showSqlPassword ? TextFieldType.Text : TextFieldType.Password)"
                                            Placeholder="@(_hasExistingSqlPassword ? "Leave blank to keep existing" : "Enter password")"
                                            Style="width: 100%;">
                                <span slot="end" @onclick="@(() => _showSqlPassword = !_showSqlPassword)" style="cursor: pointer; display: flex; align-items: center;" title="@(_showSqlPassword ? "Hide password" : "Show password")">
                                    @if (_showSqlPassword)
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size20.EyeOff())" />
                                    }
                                    else
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size20.Eye())" />
                                    }
                                </span>
                            </FluentTextField>
                        </FluentGridItem>
                    }

                    <FluentGridItem xs="12">
                        <FluentCheckbox @bind-Value="_config.SqlServerTrustServerCertificate"
                                       Label="Trust Server Certificate (for self-signed certificates)" />
                    </FluentGridItem>

                    <FluentGridItem xs="12">
                        <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px;">
                            <FluentButton Appearance="Appearance.Outline" OnClick="TestSqlConnection" Disabled="_isTestingSql">
                                @if (_isTestingSql)
                                {
                                    <FluentProgressRing Style="width: 16px; height: 16px; margin-right: 8px;" />
                                }
                                Test Connection
                            </FluentButton>
                            <FluentButton Appearance="Appearance.Accent" OnClick="SaveSqlSettings" Disabled="_isSavingSql">
                                @if (_isSavingSql)
                                {
                                    <FluentProgressRing Style="width: 16px; height: 16px; margin-right: 8px;" />
                                }
                                Save SQL Settings
                            </FluentButton>
                        </div>
                    </FluentGridItem>
                </FluentGrid>

                @if (!string.IsNullOrEmpty(_sqlConnectionStatus))
                {
                    <FluentMessageBar Intent="@_sqlConnectionStatusIntent" Style="margin-top: 16px;">
                        @_sqlConnectionStatus
                    </FluentMessageBar>
                }
            </FluentCard>
        }
        else
        {
            <FluentProgressRing />
        }
    </FluentTab>

    <FluentTab Label="AI Settings" Id="ai-settings">
        @if (_config != null)
        {
            <FluentCard Style="padding: 16px; margin-top: 16px;">
                <FluentMessageBar Intent="@MessageIntent.Info" Style="margin-bottom: 16px;">
                    Configure your AI provider and model settings. API keys will be encrypted before storage.
                </FluentMessageBar>

                <FluentGrid Spacing="3">
                    <FluentGridItem xs="12">
                        <div>
                            <label style="font-weight: 500; margin-bottom: 4px; display: block;">LLM Provider</label>
                            <select @bind="_config.LlmProvider" style="width: 100%; max-width: 300px; padding: 8px; border: 1px solid var(--neutral-stroke-rest); border-radius: 4px;">
                                <option value="@LlmProvider.OpenAI">OpenAI</option>
                                <option value="@LlmProvider.AzureOpenAI">Azure OpenAI</option>
                                <option value="@LlmProvider.Ollama">Ollama (Local)</option>
                            </select>
                        </div>
                        <span style="font-size: 12px; color: gray;">Select your LLM provider</span>
                    </FluentGridItem>

                    <FluentGridItem xs="12">
                        <hr style="border: none; border-top: 1px solid var(--neutral-stroke-rest); margin: 16px 0;" />
                    </FluentGridItem>

                    @if (_config.LlmProvider == LlmProvider.OpenAI)
                    {
                        <FluentGridItem xs="12" sm="6">
                            <FluentTextField @bind-Value="_apiKey"
                                            Label="OpenAI API Key"
                                            TextFieldType="@(_showApiKey ? TextFieldType.Text : TextFieldType.Password)"
                                            Placeholder="@(_hasExistingApiKey ? "Leave blank to keep existing key" : "sk-...")"
                                            Style="width: 100%;">
                                <span slot="end" @onclick="@(() => _showApiKey = !_showApiKey)" style="cursor: pointer; display: flex; align-items: center;" title="@(_showApiKey ? "Hide API key" : "Show API key")">
                                    @if (_showApiKey)
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size20.EyeOff())" />
                                    }
                                    else
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size20.Eye())" />
                                    }
                                </span>
                            </FluentTextField>
                        </FluentGridItem>

                        <FluentGridItem xs="12" sm="6">
                            <div>
                                <label style="font-weight: 500; margin-bottom: 4px; display: block;">Chat Model</label>
                                <select @bind="_config.OpenAiModel" style="width: 100%; padding: 8px; border: 1px solid var(--neutral-stroke-rest); border-radius: 4px;">
                                    @foreach (var model in _openAiChatModels)
                                    {
                                        <option value="@model">@model</option>
                                    }
                                </select>
                            </div>
                            <span style="font-size: 12px; color: gray;">Select the OpenAI model for chat completions</span>
                        </FluentGridItem>

                        <FluentGridItem xs="12" sm="6">
                            <div>
                                <label style="font-weight: 500; margin-bottom: 4px; display: block;">Embedding Model</label>
                                <select @bind="_config.EmbeddingModel" style="width: 100%; padding: 8px; border: 1px solid var(--neutral-stroke-rest); border-radius: 4px;">
                                    @foreach (var model in _openAiEmbeddingModels)
                                    {
                                        <option value="@model">@model</option>
                                    }
                                </select>
                            </div>
                            <span style="font-size: 12px; color: gray;">Select the model for document embeddings</span>
                        </FluentGridItem>
                    }
                    else if (_config.LlmProvider == LlmProvider.AzureOpenAI)
                    {
                        <FluentGridItem xs="12" sm="6">
                            <FluentTextField @bind-Value="_config.AzureOpenAiEndpoint"
                                            Label="Azure OpenAI Endpoint"
                                            Placeholder="https://your-resource.openai.azure.com"
                                            Style="width: 100%;" />
                            <span style="font-size: 12px; color: gray;">Your Azure OpenAI resource endpoint URL</span>
                        </FluentGridItem>

                        <FluentGridItem xs="12" sm="6">
                            <FluentTextField @bind-Value="_azureApiKey"
                                            Label="Azure OpenAI API Key"
                                            TextFieldType="@(_showAzureApiKey ? TextFieldType.Text : TextFieldType.Password)"
                                            Placeholder="@(_hasExistingAzureApiKey ? "Leave blank to keep existing key" : "Enter API key")"
                                            Style="width: 100%;">
                                <span slot="end" @onclick="@(() => _showAzureApiKey = !_showAzureApiKey)" style="cursor: pointer; display: flex; align-items: center;" title="@(_showAzureApiKey ? "Hide API key" : "Show API key")">
                                    @if (_showAzureApiKey)
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size20.EyeOff())" />
                                    }
                                    else
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size20.Eye())" />
                                    }
                                </span>
                            </FluentTextField>
                        </FluentGridItem>

                        <FluentGridItem xs="12" sm="6">
                            <FluentTextField @bind-Value="_config.AzureOpenAiDeploymentName"
                                            Label="Chat Deployment Name"
                                            Placeholder="e.g., gpt-4o-deployment"
                                            Style="width: 100%;" />
                            <span style="font-size: 12px; color: gray;">Your Azure OpenAI chat model deployment name</span>
                        </FluentGridItem>

                        <FluentGridItem xs="12" sm="6">
                            <FluentTextField @bind-Value="_config.AzureOpenAiEmbeddingDeployment"
                                            Label="Embedding Deployment Name"
                                            Placeholder="e.g., text-embedding-ada-002"
                                            Style="width: 100%;" />
                            <span style="font-size: 12px; color: gray;">Your Azure OpenAI embedding model deployment name</span>
                        </FluentGridItem>

                        <FluentGridItem xs="12" sm="6">
                            <FluentTextField @bind-Value="_config.AzureOpenAiApiVersion"
                                            Label="API Version"
                                            Placeholder="2024-02-15-preview"
                                            Style="width: 100%;" />
                            <span style="font-size: 12px; color: gray;">Azure OpenAI API version</span>
                        </FluentGridItem>
                    }
                    else if (_config.LlmProvider == LlmProvider.Ollama)
                    {
                        <FluentGridItem xs="12">
                            <FluentMessageBar Intent="@MessageIntent.Warning" Style="margin-bottom: 12px;">
                                <strong>Note:</strong> Ollama must be running locally or on a reachable server. Some embedding models may have different dimensions than OpenAI (1536). If you switch providers, you may need to re-index your documents.
                            </FluentMessageBar>
                        </FluentGridItem>

                        <FluentGridItem xs="12" sm="6">
                            <FluentTextField @bind-Value="_config.OllamaEndpoint"
                                            Label="Ollama Endpoint"
                                            Placeholder="http://localhost:11434"
                                            Style="width: 100%;" />
                            <span style="font-size: 12px; color: gray;">Ollama API endpoint URL</span>
                        </FluentGridItem>

                        <FluentGridItem xs="12" sm="6">
                            <div style="display: flex; align-items: flex-end; gap: 8px;">
                                <FluentButton Appearance="Appearance.Outline"
                                             OnClick="FetchOllamaModels"
                                             Disabled="_isFetchingOllamaModels"
                                             Style="margin-bottom: 4px;">
                                    @if (_isFetchingOllamaModels)
                                    {
                                        <FluentProgressRing Style="width: 16px; height: 16px; margin-right: 8px;" />
                                    }
                                    Fetch Models
                                </FluentButton>
                            </div>
                            <span style="font-size: 12px; color: gray;">Click to retrieve available models from your Ollama server</span>
                        </FluentGridItem>

                        <FluentGridItem xs="12" sm="6">
                            <div>
                                <label style="font-weight: 500; margin-bottom: 4px; display: block;">Chat Model</label>
                                @if (_ollamaAvailableModels.Any())
                                {
                                    <select @bind="_config.OllamaModel" style="width: 100%; padding: 8px; border: 1px solid var(--neutral-stroke-rest); border-radius: 4px;">
                                        @foreach (var model in _ollamaAvailableModels)
                                        {
                                            <option value="@model">@model</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <FluentTextField @bind-Value="_config.OllamaModel"
                                                    Placeholder="e.g., llama3.2, mistral, phi3"
                                                    Style="width: 100%;" />
                                }
                            </div>
                            <span style="font-size: 12px; color: gray;">@(_ollamaAvailableModels.Any() ? "Select from available models" : "Enter model name or click Fetch Models")</span>
                        </FluentGridItem>

                        <FluentGridItem xs="12" sm="6">
                            <div>
                                <label style="font-weight: 500; margin-bottom: 4px; display: block;">Embedding Model</label>
                                @if (_ollamaAvailableModels.Any())
                                {
                                    <select @bind="_config.OllamaEmbeddingModel" style="width: 100%; padding: 8px; border: 1px solid var(--neutral-stroke-rest); border-radius: 4px;">
                                        @foreach (var model in _ollamaAvailableModels)
                                        {
                                            <option value="@model">@model</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <FluentTextField @bind-Value="_config.OllamaEmbeddingModel"
                                                    Placeholder="e.g., nomic-embed-text, mxbai-embed-large"
                                                    Style="width: 100%;" />
                                }
                            </div>
                            <span style="font-size: 12px; color: gray;">@(_ollamaAvailableModels.Any() ? "Select from available models" : "Enter model name or click Fetch Models")</span>
                        </FluentGridItem>
                    }

                    <FluentGridItem xs="12" sm="6">
                        <FluentNumberField @bind-Value="_config.MaxTokensPerRequest"
                                          Label="Max Tokens per Request"
                                          Min="100" Max="128000"
                                          Style="width: 100%;" />
                        <span style="font-size: 12px; color: gray;">Maximum tokens allowed per API request</span>
                    </FluentGridItem>

                    <FluentGridItem xs="12" sm="6">
                        <label style="font-weight: 500; margin-bottom: 8px; display: block;">Temperature: @_temperature.ToString("F1")</label>
                        <FluentSlider @bind-Value="_temperature" Min="0" Max="2" Step="0.1f" Style="width: 100%;" />
                        <span style="font-size: 12px; color: gray;">Lower = more focused, Higher = more creative</span>
                    </FluentGridItem>

                    <FluentGridItem xs="12">
                        <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px;">
                            <FluentButton Appearance="Appearance.Accent" OnClick="TestAndSaveSettings" Disabled="_isTesting">
                                @if (_isTesting)
                                {
                                    <FluentProgressRing Style="width: 16px; height: 16px; margin-right: 8px;" />
                                }
                                Test & Save Settings
                            </FluentButton>
                        </div>
                    </FluentGridItem>

                    @if (!string.IsNullOrEmpty(_testStatus) || !string.IsNullOrEmpty(_chatTestResult) || !string.IsNullOrEmpty(_embeddingTestResult))
                    {
                        <FluentGridItem xs="12">
                            <FluentCard Style="margin-top: 16px; padding: 16px;">
                                @if (!string.IsNullOrEmpty(_testStatus))
                                {
                                    <div style="margin-bottom: 8px; font-weight: 500;">@_testStatus</div>
                                }

                                @if (!string.IsNullOrEmpty(_chatTestResult))
                                {
                                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                                        @if (_chatTestPassed)
                                        {
                                            <FluentIcon Value="@(new Icons.Filled.Size20.CheckmarkCircle())" Color="Color.Success" />
                                        }
                                        else
                                        {
                                            <FluentIcon Value="@(new Icons.Filled.Size20.DismissCircle())" Color="Color.Error" />
                                        }
                                        <span>@_chatTestResult</span>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(_embeddingTestResult))
                                {
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        @if (_embeddingTestPassed)
                                        {
                                            <FluentIcon Value="@(new Icons.Filled.Size20.CheckmarkCircle())" Color="Color.Success" />
                                        }
                                        else
                                        {
                                            <FluentIcon Value="@(new Icons.Filled.Size20.DismissCircle())" Color="Color.Error" />
                                        }
                                        <span>@_embeddingTestResult</span>
                                    </div>
                                }
                            </FluentCard>
                        </FluentGridItem>
                    }
                </FluentGrid>
            </FluentCard>
        }
        else
        {
            <FluentProgressRing />
        }
    </FluentTab>

    <FluentTab Label="RAG Settings" Id="rag-settings">
        @if (_config != null)
        {
            <FluentCard Style="padding: 16px; margin-top: 16px;">
                <FluentMessageBar Intent="@MessageIntent.Info" Style="margin-bottom: 16px;">
                    Configure Retrieval-Augmented Generation (RAG) settings for document-based chat responses.
                </FluentMessageBar>

                <FluentGrid Spacing="3">
                    <FluentGridItem xs="12">
                        <FluentCheckbox @bind-Value="_config.EnableSourcePreview"
                                       Label="Enable Source Preview" />
                        <div style="margin-left: 28px; font-size: 12px; color: gray; margin-top: 4px;">
                            When enabled, users can click to view the actual document chunks that were used to generate RAG responses.
                            This provides transparency about which sources informed the AI's answer.
                        </div>
                    </FluentGridItem>

                    <FluentGridItem xs="12">
                        <hr style="border: none; border-top: 1px solid var(--neutral-stroke-rest); margin: 16px 0;" />
                        <h5 style="margin: 0 0 12px 0;">Document Access</h5>
                        <div style="font-size: 12px; color: gray; margin-bottom: 12px;">
                            Control how users can access the original source documents from RAG responses.
                            These options only apply to file-based data sources.
                        </div>
                    </FluentGridItem>

                    <FluentGridItem xs="12">
                        <FluentCheckbox @bind-Value="_config.EnableDocumentPreview"
                                       Label="Enable Document Preview (In-Browser Viewing)" />
                        <div style="margin-left: 28px; font-size: 12px; color: gray; margin-top: 4px;">
                            Allow users to view documents directly in the browser. Documents open in a new tab.
                        </div>
                    </FluentGridItem>

                    <FluentGridItem xs="12">
                        <FluentCheckbox @bind-Value="_config.EnableDocumentDownload"
                                       Label="Enable Document Download" />
                        <div style="margin-left: 28px; font-size: 12px; color: gray; margin-top: 4px;">
                            Allow users to download the original source documents to their computer.
                        </div>
                    </FluentGridItem>

                    <FluentGridItem xs="12" sm="6">
                        <FluentNumberField @bind-Value="_config.DocumentAccessTokenExpirationMinutes"
                                          Label="Access Link Expiration (minutes)"
                                          Min="1" Max="60"
                                          Style="width: 100%;" />
                        <div style="font-size: 12px; color: gray; margin-top: 4px;">
                            How long document access links remain valid. Links are user-specific and cannot be shared.
                        </div>
                    </FluentGridItem>

                    <FluentGridItem xs="12">
                        <hr style="border: none; border-top: 1px solid var(--neutral-stroke-rest); margin: 16px 0;" />
                        <h5 style="margin: 0 0 12px 0;">Source Filtering</h5>
                        <div style="font-size: 12px; color: gray; margin-bottom: 12px;">
                            Control which sources are displayed to users based on relevance.
                        </div>
                    </FluentGridItem>

                    <FluentGridItem xs="12" sm="6">
                        <FluentNumberField @bind-Value="_config.SourcePreviewMinRelevance"
                                          Label="Minimum Relevance (%)"
                                          Min="0" Max="100"
                                          Style="width: 100%;" />
                        <div style="font-size: 12px; color: gray; margin-top: 4px;">
                            Only show sources with relevance above this threshold. Set to 0 to show all sources.
                        </div>
                    </FluentGridItem>

                    <FluentGridItem xs="12" sm="6">
                        <FluentNumberField @bind-Value="_config.SourcePreviewMaxSources"
                                          Label="Maximum Sources to Display"
                                          Min="1" Max="10"
                                          Style="width: 100%;" />
                        <div style="font-size: 12px; color: gray; margin-top: 4px;">
                            Limit the number of sources shown in the preview dialog.
                        </div>
                    </FluentGridItem>

                    <FluentGridItem xs="12">
                        <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px;">
                            <FluentButton Appearance="Appearance.Accent" OnClick="SaveRagSettings" Disabled="_isSavingRag">
                                @if (_isSavingRag)
                                {
                                    <FluentProgressRing Style="width: 16px; height: 16px; margin-right: 8px;" />
                                }
                                Save RAG Settings
                            </FluentButton>
                        </div>
                    </FluentGridItem>
                </FluentGrid>
            </FluentCard>
        }
        else
        {
            <FluentProgressRing />
        }
    </FluentTab>

    <FluentTab Label="Authentication" Id="auth-settings">
        @if (_config != null)
        {
            <FluentCard Style="padding: 16px; margin-top: 16px;">
                <FluentMessageBar Intent="@MessageIntent.Warning" Style="margin-bottom: 16px;">
                    <strong>Requires Application Restart.</strong> Changes to authentication settings require restarting the application to take effect.
                </FluentMessageBar>

                <FluentGrid Spacing="3">
                    <FluentGridItem xs="12">
                        <div>
                            <label style="font-weight: 500; margin-bottom: 4px; display: block;">Authentication Mode</label>
                            <select @bind="_config.AuthenticationMode" style="width: 100%; max-width: 300px; padding: 8px; border: 1px solid var(--neutral-stroke-rest); border-radius: 4px;">
                                <option value="Local">Local (Username/Password)</option>
                                <option value="Windows">Windows Authentication</option>
                            </select>
                        </div>
                        <span style="font-size: 12px; color: gray;">Select how users authenticate to the application</span>
                    </FluentGridItem>

                    @if (_config.AuthenticationMode == "Windows")
                    {
                        <FluentGridItem xs="12">
                            <hr style="border: none; border-top: 1px solid var(--neutral-stroke-rest); margin: 16px 0;" />
                            <h5 style="margin: 0 0 12px 0;">Windows Authentication Options</h5>
                        </FluentGridItem>

                        <FluentGridItem xs="12">
