    // Status Dashboard Methods
    private RenderFragment RenderStatusIcon(ConfigStatus status) => status switch
    {
        ConfigStatus.Success => @<FluentIcon Value="@(new Icons.Filled.Size24.CheckmarkCircle())" Color="Color.Success" />,
        ConfigStatus.Warning => @<FluentIcon Value="@(new Icons.Filled.Size24.Warning())" Color="Color.Warning" />,
        ConfigStatus.Error => @<FluentIcon Value="@(new Icons.Filled.Size24.DismissCircle())" Color="Color.Error" />,
        _ => @<FluentIcon Value="@(new Icons.Filled.Size24.QuestionCircle())" Color="Color.Neutral" />
    };

    private async Task CheckAllStatus()
    {
        _isCheckingStatus = true;
        StateHasChanged();

        try
        {
            await CheckSqlStatus();
            StateHasChanged();

            await CheckChatModelStatus();
            StateHasChanged();

            await CheckEmbeddingModelStatus();
            StateHasChanged();

            CheckRagStatus();
            StateHasChanged();

            CheckAuthStatus();
        }
        finally
        {
            _isCheckingStatus = false;
            StateHasChanged();
        }
    }

    private async Task CheckSqlStatus()
    {
        if (string.IsNullOrWhiteSpace(_config?.SqlServerHost))
        {
            _sqlStatus = ConfigStatus.Error;
            _sqlStatusMessage = "Not configured";
            return;
        }

        try
        {
            var connectionString = BuildSqlConnectionString();
            await using var connection = new SqlConnection(connectionString);
            await connection.OpenAsync();

            await using var cmd = new SqlCommand("SELECT @@VERSION", connection);
            var version = (await cmd.ExecuteScalarAsync())?.ToString() ?? "";

            if (version.Contains("2025") || version.Contains("2026") || version.Contains("2027"))
            {
                _sqlStatus = ConfigStatus.Success;
                _sqlStatusMessage = "Connected (SQL Server 2025+)";
            }
            else
            {
                _sqlStatus = ConfigStatus.Warning;
                _sqlStatusMessage = "Connected but may lack VECTOR support";
            }
        }
        catch (Exception ex)
        {
            _sqlStatus = ConfigStatus.Error;
            var msg = ex.Message;
            _sqlStatusMessage = msg.Length > 60 ? msg[..60] + "..." : msg;
        }
    }

    private async Task CheckChatModelStatus()
    {
        if (_config == null)
        {
            _chatModelStatus = ConfigStatus.Error;
            _chatModelStatusMessage = "Configuration not loaded";
            return;
        }

        var hasCredentials = _config.LlmProvider switch
        {
            LlmProvider.OpenAI => !string.IsNullOrEmpty(_config.OpenAiApiKey),
            LlmProvider.AzureOpenAI => !string.IsNullOrEmpty(_config.AzureOpenAiApiKey)
                                       && !string.IsNullOrEmpty(_config.AzureOpenAiEndpoint)
                                       && !string.IsNullOrEmpty(_config.AzureOpenAiDeploymentName),
            LlmProvider.Ollama => !string.IsNullOrEmpty(_config.OllamaEndpoint)
                                  && !string.IsNullOrEmpty(_config.OllamaModel),
            _ => false
        };

        if (!hasCredentials)
        {
            _chatModelStatus = ConfigStatus.Error;
            _chatModelStatusMessage = "Not configured";
            return;
        }

        try
        {
            var chatService = AiServiceFactory.GetChatService();
            var messages = new List<ChatMessageDto>
            {
                new(Guid.NewGuid(), DataChat.Domain.Enums.MessageRole.User, "Hi", DateTime.UtcNow)
            };

            var response = new System.Text.StringBuilder();
            await foreach (var chunk in chatService.StreamResponseAsync(messages, null, CancellationToken.None))
            {
                response.Append(chunk);
                if (response.Length > 10) break;
            }

            _chatModelStatus = ConfigStatus.Success;
            _chatModelStatusMessage = "Working";
        }
        catch (Exception ex)
        {
            _chatModelStatus = ConfigStatus.Error;
            var msg = ex.Message;
            _chatModelStatusMessage = msg.Length > 60 ? msg[..60] + "..." : msg;
        }
    }

    private async Task CheckEmbeddingModelStatus()
    {
        if (_config == null)
        {
            _embeddingModelStatus = ConfigStatus.Error;
            _embeddingModelStatusMessage = "Configuration not loaded";
            return;
        }

        var hasEmbeddingConfig = _config.LlmProvider switch
        {
            LlmProvider.OpenAI => !string.IsNullOrEmpty(_config.OpenAiApiKey),
            LlmProvider.AzureOpenAI => !string.IsNullOrEmpty(_config.AzureOpenAiApiKey)
                                       && !string.IsNullOrEmpty(_config.AzureOpenAiEmbeddingDeployment),
            LlmProvider.Ollama => !string.IsNullOrEmpty(_config.OllamaEndpoint)
                                  && !string.IsNullOrEmpty(_config.OllamaEmbeddingModel),
            _ => false
        };

        if (!hasEmbeddingConfig)
        {
            _embeddingModelStatus = ConfigStatus.Error;
            _embeddingModelStatusMessage = "Not configured";
            return;
        }

        try
        {
            var embeddingService = AiServiceFactory.GetEmbeddingService();
            var embedding = await embeddingService.GenerateEmbeddingAsync("test");

            _embeddingModelStatus = ConfigStatus.Success;
            _embeddingModelStatusMessage = $"Working ({embedding.Length} dimensions)";
        }
        catch (Exception ex)
        {
            _embeddingModelStatus = ConfigStatus.Error;
            var msg = ex.Message;
            _embeddingModelStatusMessage = msg.Length > 60 ? msg[..60] + "..." : msg;
        }
    }

    private void CheckRagStatus()
    {
        if (_config == null)
        {
            _ragStatus = ConfigStatus.Error;
            _ragStatusMessage = "Configuration not loaded";
            return;
        }

        if (_config.EnableSourcePreview && (_config.EnableDocumentPreview || _config.EnableDocumentDownload))
        {
            _ragStatus = ConfigStatus.Success;
            _ragStatusMessage = "Source preview and document access enabled";
        }
        else if (_config.EnableSourcePreview || _config.EnableDocumentPreview || _config.EnableDocumentDownload)
        {
            _ragStatus = ConfigStatus.Warning;
            _ragStatusMessage = "Partially configured";
        }
        else
        {
            _ragStatus = ConfigStatus.Warning;
            _ragStatusMessage = "All access features disabled";
        }
    }

    private void CheckAuthStatus()
    {
        if (_config == null)
        {
            _authStatus = ConfigStatus.Error;
            _authStatusMessage = "Configuration not loaded";
            return;
        }

        if (_config.AuthenticationMode == "Windows")
        {
            _authStatus = ConfigStatus.Success;
            _authStatusMessage = $"Windows Authentication{(_config.WindowsAuthAutoProvisionUsers ? " (auto-provision)" : "")}";
        }
        else
        {
            _authStatus = ConfigStatus.Success;
            _authStatusMessage = "Local (Username/Password)";
        }
    }
}
