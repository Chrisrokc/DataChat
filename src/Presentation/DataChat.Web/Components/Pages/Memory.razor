@page "/memory"
@attribute [Authorize]
@using DataChat.Domain.Entities
@using DataChat.Domain.Enums
@inject IApplicationDbContext DbContext
@inject ICurrentUserService CurrentUser
@inject IDateTimeService DateTimeService
@inject IToastService ToastService
@inject IPersonalDocumentService PersonalDocService

<PageTitle>Memory & Preferences</PageTitle>

<div style="max-width: 800px; margin: 0 auto;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <div>
            <h4 style="margin: 0;">Memory & Preferences</h4>
            <p style="color: #666; margin: 8px 0 0 0; font-size: 14px;">
                Add things you want the AI to remember about you across all conversations.
            </p>
        </div>
        <FluentButton Appearance="Appearance.Accent" OnClick="ShowAddDialog">Add Memory</FluentButton>
    </div>

    @if (_isLoading)
    {
        <FluentProgress />
    }
    else if (!_memories.Any())
    {
        <FluentCard Style="padding: 48px; text-align: center;">
            <div style="margin-bottom: 16px;">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="#ccc">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                </svg>
            </div>
            <h5 style="margin: 0 0 8px 0; color: #666;">No memories yet</h5>
            <p style="color: #888; margin: 0 0 24px 0;">
                Add preferences, facts, or instructions for the AI to remember about you.
            </p>
            <FluentButton Appearance="Appearance.Accent" OnClick="ShowAddDialog">Add Your First Memory</FluentButton>
        </FluentCard>
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 12px;">
            @foreach (var category in _memories.GroupBy(m => m.Category).OrderBy(g => GetCategoryOrder(g.Key)))
            {
                <FluentCard Style="padding: 16px;">
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
                        <FluentBadge BackgroundColor="@GetCategoryColor(category.Key)" Color="white">
                            @GetCategoryDisplayName(category.Key)
                        </FluentBadge>
                        <span style="font-size: 12px; color: #888;">@category.Count() items</span>
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        @foreach (var memory in category.OrderByDescending(m => m.Priority))
                        {
                            <div class="memory-item" style="display: flex; align-items: flex-start; justify-content: space-between; padding: 12px; background: var(--neutral-layer-2); border-radius: 8px; @(!memory.IsActive ? "opacity: 0.5;" : "")">
                                <div style="flex: 1; min-width: 0;">
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <span style="font-size: 14px;">@memory.Content</span>
                                        @if (memory.Priority > 0)
                                        {
                                            <FluentBadge BackgroundColor="#ffb900" Color="white" Style="font-size: 10px;">High Priority</FluentBadge>
                                        }
                                        @if (!memory.IsActive)
                                        {
                                            <FluentBadge BackgroundColor="#888" Color="white" Style="font-size: 10px;">Disabled</FluentBadge>
                                        }
                                    </div>
                                    <div style="font-size: 11px; color: #888; margin-top: 4px;">
                                        Added @FormatTimeAgo(memory.CreatedAt)
                                    </div>
                                </div>
                                <div style="display: flex; gap: 4px; flex-shrink: 0;">
                                    <FluentButton Appearance="Appearance.Stealth" OnClick="() => ToggleMemory(memory)" Title="@(memory.IsActive ? "Disable" : "Enable")">
                                        @if (memory.IsActive)
                                        {
                                            <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor"><path d="M10 2a8 8 0 100 16 8 8 0 000-16zM3 10a7 7 0 1114 0 7 7 0 01-14 0z"/><path d="M10 6a4 4 0 100 8 4 4 0 000-8z"/></svg>
                                        }
                                        else
                                        {
                                            <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor"><path d="M10 2a8 8 0 100 16 8 8 0 000-16zM3 10a7 7 0 1114 0 7 7 0 01-14 0z"/></svg>
                                        }
                                    </FluentButton>
                                    <FluentButton Appearance="Appearance.Stealth" OnClick="() => EditMemory(memory)" Title="Edit">
                                        <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor"><path d="M14.846 1.403a2.45 2.45 0 013.465 3.465l-9.193 9.192a1.5 1.5 0 01-.536.335l-4.5 1.5a.75.75 0 01-.949-.949l1.5-4.5a1.5 1.5 0 01.335-.536l9.193-9.192a.75.75 0 01.685.685z"/></svg>
                                    </FluentButton>
                                    <FluentButton Appearance="Appearance.Stealth" OnClick="() => DeleteMemory(memory)" Title="Delete">
                                        <svg width="16" height="16" viewBox="0 0 20 20" fill="#d13438"><path d="M8.5 4h3a1.5 1.5 0 00-3 0zm-1 0a2.5 2.5 0 015 0h5a.5.5 0 010 1h-1.054l-1.194 10.344A3 3 0 0112.272 18H7.728a3 3 0 01-2.98-2.656L3.554 5H2.5a.5.5 0 010-1h5z"/></svg>
                                    </FluentButton>
                                </div>
                            </div>
                        }
                    </div>
                </FluentCard>
            }
        </div>

        <div style="margin-top: 24px; padding: 16px; background: var(--neutral-layer-2); border-radius: 8px;">
            <h6 style="margin: 0 0 8px 0;">Tips for effective memories</h6>
            <ul style="margin: 0; padding-left: 20px; color: #666; font-size: 13px;">
                <li>Be specific: "I prefer concise answers" works better than "I like short things"</li>
                <li>Use preferences for communication style: "Always use bullet points for lists"</li>
                <li>Add context about your work: "I'm a software developer working with C#"</li>
                <li>Include instructions: "Always include code examples when explaining concepts"</li>
            </ul>
        </div>
    }

    @* My Documents Section *@
    <div style="margin-top: 40px; border-top: 1px solid var(--neutral-stroke-rest); padding-top: 32px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
            <div>
                <h4 style="margin: 0;">My Documents</h4>
                <p style="color: #666; margin: 8px 0 0 0; font-size: 14px;">
                    Upload documents for your personal knowledge base. The AI can search these when you ask questions.
                </p>
            </div>
        </div>

        @* Upload Area *@
        <div class="upload-drop-zone @(_isDragOver ? "drag-over" : "")"
             @ondragenter="HandleDragEnter"
             @ondragleave="HandleDragLeave"
             @ondragover="HandleDragOver"
             @ondragover:preventDefault
             @ondrop="HandleDrop"
             @ondrop:preventDefault>
            <InputFile OnChange="HandleFileSelected" accept=".pdf,.docx,.txt,.md,.png,.jpg,.jpeg,.xlsx,.csv" multiple id="personalDocInput" style="display: none;" />
            <label for="personalDocInput" style="cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 12px;">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="#0078d4">
                    <path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z"/>
                </svg>
                <div style="text-align: center;">
                    <div style="font-size: 14px; font-weight: 500;">Drop files here or click to upload</div>
                    <div style="font-size: 12px; color: #888; margin-top: 4px;">
                        PDF, Word, Text, Images, Excel/CSV (max @FormatFileSize(PersonalDocService.GetMaxFileSize()) each)
                    </div>
                </div>
            </label>
        </div>

        @* Upload Progress *@
        @if (_isUploading)
        {
            <div style="margin-top: 16px; padding: 16px; background: var(--neutral-layer-2); border-radius: 8px; display: flex; align-items: center; gap: 12px;">
                <FluentProgressRing Style="width: 24px; height: 24px;" />
                <div>
                    <div style="font-size: 14px; font-weight: 500;">Uploading and processing...</div>
                    <div style="font-size: 12px; color: #888;">@_uploadingFileName</div>
                </div>
            </div>
        }

        @* Storage Usage *@
        <div style="margin-top: 16px; display: flex; align-items: center; gap: 12px;">
            <div style="flex: 1; height: 8px; background: var(--neutral-layer-3); border-radius: 4px; overflow: hidden;">
                <div style="height: 100%; background: @GetStorageColor(); width: @GetStoragePercent()%; transition: width 0.3s;"></div>
            </div>
            <div style="font-size: 12px; color: #666; white-space: nowrap;">
                @FormatFileSize(_storageUsed) / @FormatFileSize(PersonalDocService.GetStorageLimit())
            </div>
        </div>

        @* Document List *@
        @if (_isLoadingDocs)
        {
            <div style="margin-top: 24px;">
                <FluentProgress />
            </div>
        }
        else if (!_personalDocuments.Any())
        {
            <div style="margin-top: 24px; padding: 32px; text-align: center; background: var(--neutral-layer-2); border-radius: 8px;">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="#ccc" style="margin-bottom: 12px;">
                    <path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
                </svg>
                <div style="font-size: 14px; color: #666;">No documents uploaded yet</div>
                <div style="font-size: 12px; color: #888; margin-top: 4px;">Upload documents to create your personal knowledge base</div>
            </div>
        }
        else
        {
            <div style="margin-top: 24px; display: flex; flex-direction: column; gap: 8px;">
                @foreach (var doc in _personalDocuments)
                {
                    <div class="document-item" style="display: flex; align-items: center; gap: 12px; padding: 12px 16px; background: var(--neutral-layer-2); border-radius: 8px;">
                        <div style="flex-shrink: 0;">
                            @GetFileIcon(doc.MimeType)
                        </div>
                        <div style="flex: 1; min-width: 0;">
                            <div style="font-size: 14px; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                @doc.FileName
                            </div>
                            <div style="font-size: 11px; color: #888; display: flex; gap: 8px; align-items: center; margin-top: 2px;">
                                <span>@FormatFileSize(doc.FileSize)</span>
                                <span style="color: #ccc;">|</span>
                                <span>@FormatTimeAgo(doc.CreatedAt)</span>
                                <span style="color: #ccc;">|</span>
                                @if (doc.Status == DocumentStatus.Indexed)
                                {
                                    <span style="color: #107c10;">Ready</span>
                                }
                                else if (doc.Status == DocumentStatus.Processing || doc.Status == DocumentStatus.Pending)
                                {
                                    <span style="color: #ffb900;">Processing...</span>
                                }
                                else if (doc.Status == DocumentStatus.Failed)
                                {
                                    <span style="color: #d13438;">Failed</span>
                                }
                            </div>
                        </div>
                        <FluentButton Appearance="Appearance.Stealth" OnClick="() => DeleteDocument(doc)" Title="Delete" Disabled="@_isDeleting">
                            <svg width="16" height="16" viewBox="0 0 20 20" fill="#d13438"><path d="M8.5 4h3a1.5 1.5 0 00-3 0zm-1 0a2.5 2.5 0 015 0h5a.5.5 0 010 1h-1.054l-1.194 10.344A3 3 0 0112.272 18H7.728a3 3 0 01-2.98-2.656L3.554 5H2.5a.5.5 0 010-1h5z"/></svg>
                        </FluentButton>
                    </div>
                }
            </div>
        }
    </div>
</div>

@* Add/Edit Memory Dialog *@
@if (_showDialog)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;" @onclick="CloseDialog">
        <FluentCard Style="width: 500px; max-width: 90vw; padding: 24px;" @onclick:stopPropagation="true">
            <h5 style="margin: 0 0 20px 0;">@(_editingMemory == null ? "Add Memory" : "Edit Memory")</h5>

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 13px; font-weight: 500; margin-bottom: 6px;">Category</label>
                <select @bind="_dialogCategory" style="width: 100%; padding: 10px 12px; border: 1px solid var(--neutral-stroke-rest); border-radius: 4px; background: var(--neutral-layer-1); font-size: 14px;">
                    <option value="preference">Preference - How I like responses</option>
                    <option value="fact">Fact - About me or my work</option>
                    <option value="instruction">Instruction - Things to always do</option>
                    <option value="context">Context - Background information</option>
                    <option value="general">General</option>
                </select>
            </div>

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 13px; font-weight: 500; margin-bottom: 6px;">Memory Content</label>
                <textarea @bind="_dialogContent" placeholder="E.g., I prefer code examples in Python" rows="3" style="width: 100%; padding: 10px 12px; border: 1px solid var(--neutral-stroke-rest); border-radius: 4px; font-size: 14px; resize: vertical; font-family: inherit;"></textarea>
            </div>

            <div style="margin-bottom: 24px;">
                <FluentCheckbox @bind-Value="_dialogHighPriority">
                    High priority (always apply this memory)
                </FluentCheckbox>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 8px;">
                <FluentButton Appearance="Appearance.Stealth" OnClick="CloseDialog">Cancel</FluentButton>
                <FluentButton Appearance="Appearance.Accent" OnClick="SaveMemory" Disabled="@(string.IsNullOrWhiteSpace(_dialogContent) || _isSaving)">
                    @if (_isSaving)
                    {
                        <FluentProgressRing Style="width: 16px; height: 16px; margin-right: 8px;" />
                    }
                    @(_editingMemory == null ? "Add Memory" : "Save Changes")
                </FluentButton>
            </div>
        </FluentCard>
    </div>
}

<style>
    .memory-item:hover {
        background: var(--neutral-layer-3) !important;
    }
    .upload-drop-zone {
        border: 2px dashed var(--neutral-stroke-rest);
        border-radius: 12px;
        padding: 32px;
        text-align: center;
        transition: all 0.2s ease;
        background: var(--neutral-layer-1);
    }
    .upload-drop-zone:hover, .upload-drop-zone.drag-over {
        border-color: #0078d4;
        background: rgba(0, 120, 212, 0.05);
    }
    .document-item:hover {
        background: var(--neutral-layer-3) !important;
    }
</style>

@code {
    private List<UserMemory> _memories = new();
    private bool _isLoading = true;
    private bool _showDialog;
    private bool _isSaving;
    private bool _isProcessing; // Prevents concurrent operations

    // Dialog state
    private UserMemory? _editingMemory;
    private string _dialogCategory = "preference";
    private string _dialogContent = "";
    private bool _dialogHighPriority;

    // Document state
    private List<Document> _personalDocuments = new();
    private bool _isLoadingDocs = true;
    private bool _isUploading;
    private bool _isDeleting;
    private bool _isDragOver;
    private string _uploadingFileName = "";
    private long _storageUsed;

    protected override async Task OnInitializedAsync()
    {
        // Run sequentially to avoid DbContext concurrency issues
        await LoadMemories();
        await LoadPersonalDocuments();
    }

    private async Task LoadMemories()
    {
        try
        {
            _isLoading = true;
            var userId = CurrentUser.UserId;
            if (userId != null)
            {
                _memories = await DbContext.UserMemories
                    .Where(m => m.UserId == userId.Value)
                    .OrderByDescending(m => m.Priority)
                    .ThenByDescending(m => m.CreatedAt)
                    .ToListAsync();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load memories: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ShowAddDialog()
    {
        _editingMemory = null;
        _dialogCategory = "preference";
        _dialogContent = "";
        _dialogHighPriority = false;
        _showDialog = true;
    }

    private void EditMemory(UserMemory memory)
    {
        _editingMemory = memory;
        _dialogCategory = memory.Category;
        _dialogContent = memory.Content;
        _dialogHighPriority = memory.Priority > 0;
        _showDialog = true;
    }

    private void CloseDialog()
    {
        _showDialog = false;
        _editingMemory = null;
    }

    private async Task SaveMemory()
    {
        if (string.IsNullOrWhiteSpace(_dialogContent)) return;

        var userId = CurrentUser.UserId;
        if (userId == null)
        {
            ToastService.ShowError("User not authenticated");
            return;
        }

        _isSaving = true;
        try
        {
            if (_editingMemory != null)
            {
                // Update existing
                _editingMemory.Category = _dialogCategory;
                _editingMemory.Content = _dialogContent.Trim();
                _editingMemory.Priority = _dialogHighPriority ? 1 : 0;
                _editingMemory.UpdatedAt = DateTimeService.UtcNow;
            }
            else
            {
                // Add new
                var memory = new UserMemory
                {
                    Id = Guid.NewGuid(),
                    UserId = userId.Value,
                    Category = _dialogCategory,
                    Content = _dialogContent.Trim(),
                    Priority = _dialogHighPriority ? 1 : 0,
                    IsActive = true,
                    CreatedAt = DateTimeService.UtcNow
                };
                DbContext.UserMemories.Add(memory);
            }

            await DbContext.SaveChangesAsync();
            ToastService.ShowSuccess(_editingMemory != null ? "Memory updated" : "Memory added");
            CloseDialog();
            await LoadMemories();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to save: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ToggleMemory(UserMemory memory)
    {
        if (_isProcessing) return;
        _isProcessing = true;

        try
        {
            memory.IsActive = !memory.IsActive;
            memory.UpdatedAt = DateTimeService.UtcNow;
            await DbContext.SaveChangesAsync();
            ToastService.ShowInfo(memory.IsActive ? "Memory enabled" : "Memory disabled");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to toggle: {ex.Message}");
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task DeleteMemory(UserMemory memory)
    {
        if (_isProcessing) return;
        _isProcessing = true;

        try
        {
            DbContext.UserMemories.Remove(memory);
            await DbContext.SaveChangesAsync();
            _memories.Remove(memory);
            ToastService.ShowSuccess("Memory deleted");
        }
        catch (Exception ex)
        {
            // Reload to get fresh state if there was a concurrency issue
            await LoadMemories();
            ToastService.ShowError($"Failed to delete: {ex.Message}");
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private string GetCategoryDisplayName(string category) => category switch
    {
        "preference" => "Preferences",
        "fact" => "Facts",
        "instruction" => "Instructions",
        "context" => "Context",
        _ => "General"
    };

    private string GetCategoryColor(string category) => category switch
    {
        "preference" => "#0078d4",
        "fact" => "#5c2d91",
        "instruction" => "#107c10",
        "context" => "#ffb900",
        _ => "#888"
    };

    private int GetCategoryOrder(string category) => category switch
    {
        "instruction" => 0,
        "preference" => 1,
        "fact" => 2,
        "context" => 3,
        _ => 4
    };

    private string FormatTimeAgo(DateTime dateTime)
    {
        var diff = DateTime.UtcNow - dateTime;
        if (diff.TotalMinutes < 1) return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        return dateTime.ToString("MMM d, yyyy");
    }

    // Document methods
    private async Task LoadPersonalDocuments()
    {
        try
        {
            _isLoadingDocs = true;
            var userId = CurrentUser.UserId;
            if (userId != null)
            {
                _personalDocuments = (await PersonalDocService.GetUserDocumentsAsync(userId.Value)).ToList();
                _storageUsed = await PersonalDocService.GetStorageUsedAsync(userId.Value);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load documents: {ex.Message}");
        }
        finally
        {
            _isLoadingDocs = false;
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var userId = CurrentUser.UserId;
        if (userId == null)
        {
            ToastService.ShowError("User not authenticated");
            return;
        }

        foreach (var file in e.GetMultipleFiles(10)) // Allow up to 10 files at once
        {
            if (_isUploading) continue;

            try
            {
                _isUploading = true;
                _uploadingFileName = file.Name;
                StateHasChanged();

                await using var stream = file.OpenReadStream(maxAllowedSize: PersonalDocService.GetMaxFileSize());
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                ms.Position = 0;

                await PersonalDocService.UploadDocumentAsync(userId.Value, ms, file.Name, file.ContentType);
                ToastService.ShowSuccess($"Uploaded: {file.Name}");
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Failed to upload {file.Name}: {ex.Message}");
            }
            finally
            {
                _isUploading = false;
                _uploadingFileName = "";
            }
        }

        await LoadPersonalDocuments();
    }

    private void HandleDragEnter(DragEventArgs e) => _isDragOver = true;
    private void HandleDragLeave(DragEventArgs e) => _isDragOver = false;
    private void HandleDragOver(DragEventArgs e) => e.DataTransfer.DropEffect = "copy";

    private void HandleDrop(DragEventArgs e)
    {
        _isDragOver = false;
        // Note: Blazor doesn't support direct file drop yet, user must use the file input
        ToastService.ShowInfo("Please use the upload button to select files");
    }

    private async Task DeleteDocument(Document doc)
    {
        if (_isDeleting) return;

        var userId = CurrentUser.UserId;
        if (userId == null) return;

        try
        {
            _isDeleting = true;
            await PersonalDocService.DeleteDocumentAsync(userId.Value, doc.Id);
            _personalDocuments.Remove(doc);
            _storageUsed = await PersonalDocService.GetStorageUsedAsync(userId.Value);
            ToastService.ShowSuccess($"Deleted: {doc.FileName}");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to delete: {ex.Message}");
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024):F1} MB";
        return $"{bytes / (1024.0 * 1024 * 1024):F1} GB";
    }

    private int GetStoragePercent()
    {
        var limit = PersonalDocService.GetStorageLimit();
        if (limit == 0) return 0;
        return (int)Math.Min(100, _storageUsed * 100 / limit);
    }

    private string GetStorageColor()
    {
        var percent = GetStoragePercent();
        if (percent >= 90) return "#d13438";
        if (percent >= 70) return "#ffb900";
        return "#107c10";
    }

    private MarkupString GetFileIcon(string? mimeType)
    {
        var color = mimeType switch
        {
            "application/pdf" => "#d13438",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document" => "#2b579a",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" => "#217346",
            "text/csv" => "#217346",
            "image/png" or "image/jpeg" => "#0078d4",
            _ => "#666"
        };

        var icon = mimeType switch
