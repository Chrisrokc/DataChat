@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject IDbContextFactory<DataChat.Infrastructure.Persistence.ApplicationDbContext> DbContextFactory

<FluentDesignTheme @bind-Mode="@_themeMode" StorageName="theme" />
<FluentDialogProvider />
<FluentToastProvider />
<FluentTooltipProvider />

<div style="display: flex; flex-direction: column; height: 100vh;">
    @* Announcement Banner *@
    @if (_showAnnouncement && !string.IsNullOrEmpty(_announcementMessage))
    {
        <div class="announcement-banner @_announcementType">
            <div class="announcement-icon">
                @if (_announcementType == "info")
                {
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                    </svg>
                }
                else if (_announcementType == "warning")
                {
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                    </svg>
                }
                else if (_announcementType == "error")
                {
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                    </svg>
                }
                else
                {
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                }
            </div>
            <div class="announcement-message">@_announcementMessage</div>
            @if (_announcementDismissible)
            {
                <button class="announcement-dismiss" @onclick="DismissAnnouncement" title="Dismiss">
                    <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M4.089 4.216l.057-.07a.5.5 0 01.638-.057l.07.057L10 9.293l5.146-5.147a.5.5 0 01.638-.057l.07.057a.5.5 0 01.057.638l-.057.07L10.707 10l5.147 5.146a.5.5 0 01.057.638l-.057.07a.5.5 0 01-.638.057l-.07-.057L10 10.707l-5.146 5.147a.5.5 0 01-.638.057l-.07-.057a.5.5 0 01-.057-.638l.057-.07L9.293 10 4.146 4.854a.5.5 0 01-.057-.638l.057-.07-.057.07z"/>
                    </svg>
                </button>
            }
        </div>
    }
    @* Header - frosted glass style *@
    <header class="copilot-header">
        <button @onclick="ToggleDrawer"
                style="background: none; border: none; cursor: pointer; padding: 8px; border-radius: 8px; display: flex; align-items: center; justify-content: center;"
                title="Toggle menu">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                <path d="M2 4.5C2 4.22386 2.22386 4 2.5 4H17.5C17.7761 4 18 4.22386 18 4.5C18 4.77614 17.7761 5 17.5 5H2.5C2.22386 5 2 4.77614 2 4.5ZM2 9.5C2 9.22386 2.22386 9 2.5 9H17.5C17.7761 9 18 9.22386 18 9.5C18 9.77614 17.7761 10 17.5 10H2.5C2.22386 10 2 9.77614 2 9.5ZM2.5 14C2.22386 14 2 14.2239 2 14.5C2 14.7761 2.22386 15 2.5 15H17.5C17.7761 15 18 14.7761 18 14.5C18 14.2239 17.7761 14 17.5 14H2.5Z"/>
            </svg>
        </button>

        <div style="display: flex; align-items: center; gap: 8px; margin-left: 12px;">
            @* Copilot-style icon *@
            <div style="width: 28px; height: 28px; background: linear-gradient(135deg, #0078d4, #5c2d91); border-radius: 6px; display: flex; align-items: center; justify-content: center;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="white">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                </svg>
            </div>
            <span style="font-weight: 600; font-size: 16px; color: #242424;">DataChat</span>
        </div>

        <div style="flex: 1;"></div>

        <button @onclick="ToggleDarkMode"
                style="background: none; border: none; cursor: pointer; padding: 8px; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-right: 8px;"
                title="Toggle theme">
            @if (_themeMode == DesignThemeModes.Dark)
            {
                <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"/>
                </svg>
            }
            else
            {
                <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/>
                </svg>
            }
        </button>

        <AuthorizeView>
            <Authorized>
                <div style="display: flex; align-items: center; gap: 12px;">
                    <span style="color: #666; font-size: 14px;">@context.User.Identity?.Name</span>
                    <div style="width: 32px; height: 32px; background: linear-gradient(135deg, #667eea, #764ba2); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; font-size: 14px;">
                        @(context.User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>
    </header>

    <div style="display: flex; flex: 1; overflow: hidden;">
        @* Sidebar - frosted glass style *@
        @if (_drawerOpen)
        {
            <nav class="copilot-sidebar" style="width: 260px; height: 100%; overflow-y: auto; padding: 8px 0;">
                <NavMenu />
            </nav>
        }

        @* Main content *@
        <main style="flex: 1; overflow-y: auto; padding: 24px;">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">X</a>
</div>

<style>
    .announcement-banner {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 16px;
        font-size: 14px;
        z-index: 100;
    }

    .announcement-banner.info {
        background: rgba(0, 120, 212, 0.1);
        border-bottom: 1px solid rgba(0, 120, 212, 0.2);
        color: #0078d4;
    }

    .announcement-banner.success {
        background: rgba(16, 124, 16, 0.1);
        border-bottom: 1px solid rgba(16, 124, 16, 0.2);
        color: #107c10;
    }

    .announcement-banner.warning {
        background: rgba(255, 185, 0, 0.15);
        border-bottom: 1px solid rgba(255, 185, 0, 0.3);
        color: #8a6914;
    }

    .announcement-banner.error {
        background: rgba(209, 52, 56, 0.1);
        border-bottom: 1px solid rgba(209, 52, 56, 0.2);
        color: #d13438;
    }

    body.dark-theme .announcement-banner.info {
        background: rgba(0, 120, 212, 0.15);
        color: #4da6ff;
    }

    body.dark-theme .announcement-banner.success {
        background: rgba(16, 124, 16, 0.15);
        color: #3cb043;
    }

    body.dark-theme .announcement-banner.warning {
        background: rgba(255, 185, 0, 0.2);
        color: #ffb900;
    }

    body.dark-theme .announcement-banner.error {
        background: rgba(209, 52, 56, 0.15);
        color: #f87171;
    }

    .announcement-icon {
        flex-shrink: 0;
    }

    .announcement-message {
        flex: 1;
    }

    .announcement-dismiss {
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 4px;
        border-radius: 4px;
        opacity: 0.7;
        transition: opacity 0.15s;
        color: inherit;
    }

    .announcement-dismiss:hover {
        opacity: 1;
    }
</style>

@code {
    private bool _drawerOpen = true;
    private DesignThemeModes _themeMode = DesignThemeModes.Light;

    // Announcement state
    private bool _showAnnouncement;
    private string _announcementMessage = "";
    private string _announcementType = "info";
    private bool _announcementDismissible = true;
    private bool _announcementDismissed;

    protected override async Task OnInitializedAsync()
    {
        await LoadAnnouncement();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Apply theme class to body for custom CSS
            await ApplyThemeToBody();
        }
    }

    private async Task LoadAnnouncement()
    {
        try
        {
            // Use a separate DbContext instance to avoid concurrency issues with page components
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var config = await dbContext.SystemConfiguration.FirstOrDefaultAsync();
            if (config != null && config.AnnouncementEnabled && !string.IsNullOrWhiteSpace(config.AnnouncementMessage))
            {
                var now = DateTime.UtcNow;

                // Check date range
                var isWithinDateRange = true;
                if (config.AnnouncementStartDate.HasValue && now < config.AnnouncementStartDate.Value)
                    isWithinDateRange = false;
                if (config.AnnouncementEndDate.HasValue && now > config.AnnouncementEndDate.Value)
                    isWithinDateRange = false;

                if (isWithinDateRange)
                {
                    _announcementMessage = config.AnnouncementMessage;
                    _announcementType = config.AnnouncementType;
                    _announcementDismissible = config.AnnouncementDismissible;
                    _showAnnouncement = true;
                }
            }
        }
        catch
        {
            // Ignore errors - announcement is non-critical
        }
    }

    private void DismissAnnouncement()
    {
        _showAnnouncement = false;
        _announcementDismissed = true;
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task ToggleDarkMode()
    {
        _themeMode = _themeMode == DesignThemeModes.Dark
            ? DesignThemeModes.Light
            : DesignThemeModes.Dark;
        await ApplyThemeToBody();
        StateHasChanged();
    }

    private async Task ApplyThemeToBody()
    {
        try
        {
            var isDark = _themeMode == DesignThemeModes.Dark;
            await JS.InvokeVoidAsync("eval", $"document.body.classList.toggle('dark-theme', {isDark.ToString().ToLower()})");
        }
        catch
        {
            // Ignore JS interop errors during prerendering
        }
    }
}
