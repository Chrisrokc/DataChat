<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.datachat.app</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Applications/DataChat/DataChat.Web</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Applications/DataChat</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/Applications/DataChat/logs/launchagent-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Applications/DataChat/logs/launchagent-stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>ASPNETCORE_ENVIRONMENT</key>
        <string>Production</string>
        <!-- So the Tesseract NuGet wrapper can dlopen Homebrew-installed
             libtesseract.dylib on both Apple Silicon and Intel Macs. -->
        <key>DYLD_FALLBACK_LIBRARY_PATH</key>
        <string>/opt/homebrew/lib:/usr/local/lib:/usr/lib</string>
    </dict>
</dict>
</plist>
